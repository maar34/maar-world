{
  "name": "maar-world",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Maar World — one static Astro site consolidating maar.world, collect.maar.world and tree.maar.world.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/assemble-public.mjs && astro dev",
    "build": "node scripts/assemble-public.mjs && astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify.mjs",
    "verify:contract": "node scripts/verify-contract.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:cards": "node scripts/verify-cards.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "verify:actions": "node scripts/verify-actions.mjs",
    "verify:translations": "node scripts/verify-translations.mjs",
    "i18n:map": "node scripts/i18n-map.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:selftest": "node scripts/selftest.mjs",
    "verify:schemas": "node scripts/check-schemas.mjs",
    "freeze:routes": "node scripts/collect-seeds.mjs && node scripts/freeze-routes.mjs && node scripts/author-policy.mjs",
    "contract:relock": "node scripts/contract-lock.mjs relock",
    "check:links": "node scripts/check-external-links.mjs",
    "links:review-removals": "node scripts/review-link-removals.mjs",
    "author:redirects": "node scripts/author-redirects.mjs",
    "shim": "node scripts/author-redirect-shim.mjs && node scripts/verify-shim.mjs",
    "shim:verify": "node scripts/verify-shim.mjs",
    "author:content-expectations": "node scripts/author-content-expectations.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@material-symbols/svg-400": "0.47.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.3.1",
    "embla-carousel": "^8.6.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
