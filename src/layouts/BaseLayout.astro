---
/**
 * The shell every route renders inside.
 *
 * One surface: dark, on every route. It is not a theme toggle and there is
 * nothing to toggle to — see the note on `Shell` below for the second shell
 * that used to exist and why MW-16 removed it. Printing is handled by
 * `@media print` in tokens.css, which is a different question from this one.
 *
 * Fonts are imported from @fontsource and therefore served from this origin.
 * No page may request a font, script, style or frame from a third-party host —
 * launching with no analytics and no cookie banner depends on nothing
 * third-party firing on page load.
 */

// Self-hosted faces. Bodoni Moda carries an italic because mark.face swaps one
// word to italic bodoni; the other three need a single weight each.
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/400-italic.css';
/**
 * Archivo, as a variable font — for one axis, `wdth`.
 *
 * `@fontsource/archivo` ships static weight files with no width axis, so
 * `font-stretch` on them is silently inert: the browser matches the one width
 * it has and draws it, and nothing synthesises a wider face. 4a sets
 * font-stretch 110–124% on every Archivo mark, and it is part of why a cut word
 * reads as a clipping rather than a chip, so the static package could not
 * produce the language no matter what the stylesheet asked for.
 *
 * This is the SAME typeface, not a substitute — same family, same designer,
 * same OFL licence, same 5.3.0 — with its axes intact: `font-weight: 100 900`
 * and `font-stretch: 62% 125%`, which covers 4a's range with room either side.
 *
 * It costs. The latin subset is 90 KB against the static 600's 14 KB, and latin
 * is the subset essentially every visitor fetches. That is the whole price of
 * the width axis and it is recorded in MIGRATION-LEDGER.md as
 * `MW-11 NOTE design/archivo-variable-cost` — reversible by restoring the two
 * lines this replaced.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/libre-franklin/400.css';
import '@fontsource/dm-mono/400.css';

import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/type.css';
import '../styles/shell.css';
import '../styles/button.css';
import '../styles/mark.css';
import '../styles/paper-phrase.css';
import '../styles/collage-field.css';
import '../styles/tree-hub.css';
/* patterns/card — §04, the fundamental unit. Global because the page families
   that consume it are routes, not one component. */
import '../styles/card.css';
/* ui/carousel — §06. Styles markup the MIGRATION emits, not a component of
   ours, which is why it is global rather than scoped. */
import '../styles/carousel.css';
/* The rendered body of every page — permanent, and checked for completeness by
   verify:build. Imported before legacy.css so a dead-theme class name can
   override the element rhythm it sits inside, never the other way round. */
import '../styles/prose.css';
/* Disposable: rules keyed to a dead Jekyll theme's class names. Delete this
   import and the file together when the migration stops emitting them. */
import '../styles/legacy.css';

import { SITE, AREAS, type AreaName } from '../config/site';
import { urlOf } from '../lib/translations.mjs';

/**
 * The page's area pigment, bound once on the document element.
 *
 * `mark.highlight` in styles/mark.css reads `--area-pigment`, so a heading
 * marked on a Collect page is marked in Collect's own pink — the pigment roles
 * the spec gives the three areas, doing the job it gives them. The header's
 * current-area field already reads the same value out of AREAS, so there is one
 * source for it and no second copy in CSS.
 *
 * It goes on `<html>` rather than `<body>` deliberately: an expression between
 * `</head>` and `<body>` makes Astro drop the `<body>` tag entirely, and every
 * check that reads a page's body text then sees an empty document.
 */
import ShellDark from './shell-dark/Shell.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  /**
   * Which of the three merged areas this page belongs to. Drives one pigment
   * role in the navigation, so Maar, Collect and Tree stay legible as distinct
   * areas inside a single site.
   */
  area?: AreaName;
  /**
   * The document's own language, from the page record's `lang`.
   *
   * This used to be hardcoded `en` on all 133 pages, including the 10 Spanish
   * /lab/es/* articles. A screen reader given the wrong language reads Spanish
   * with English phonemes, and a translation tool is told there is nothing to
   * translate — so this is the difference between a page being readable and
   * being unusable, not a metadata nicety.
   */
  lang?: string;
  /**
   * Other-language versions of this page, for `<link rel="alternate">`.
   *
   * Search engines and translation tools have no other way to learn that
   * /lab/en/shared-culture and /lab/es/cultura-compartida are one page in two
   * languages — the slugs are translations of each other, not copies, so
   * nothing about the URLs reveals it.
   */
  alternates?: { lang: string; outputPath: string }[];
  /**
   * A deprecated address that production serves as a 200 with a meta refresh,
   * not as an HTTP redirect. `/interplanetary-players` is the only one. Kept as
   * a meta refresh rather than JavaScript so it works with scripting disabled.
   */
  redirectTo?: string;
  /**
   * Shared content-width contract. Every shell consumes this, so a deliberate
   * exception is data passed through one layout boundary—not a route-specific
   * class or a CSS patch.
   */
  contentWidth?: 'standard' | 'reading';
  /** The EN/ES choices rendered in the global header. */
  languageChoices?: {
    lang: string;
    label: string;
    outputPath?: string;
    current: boolean;
    unavailable: boolean;
  }[];
  /**
   * English navigation URL → the same destination in this page's language.
   * Built by `navPathsFor`; without it the header sends a Spanish reader back
   * to English on their first click.
   */
  navPaths?: Record<string, string>;
  /** The record's own outputPath — the canonical URL is derived from it. */
  outputPath?: string;
}

const {
  title,
  description,
  noindex = false,
  canonical,
  area = 'maar',
  lang = 'en',
  alternates = [],
  redirectTo,
  contentWidth = 'standard',
  languageChoices,
  navPaths = {},
  outputPath,
} = Astro.props;

/**
 * The canonical URL, from the RECORD and not from the build path.
 *
 * `Astro.url.pathname` is the path the builder emitted, so a directory index
 * arrived here as `/es/index.html` and the page then declared THAT as its
 * canonical URL and as its own hreflang entry. Same defect as the language
 * switcher's: a `…/index.html` spelling nobody navigates to. `outputPath` is
 * authoritative, so the canonical URL is derived from it.
 *
 * No route changes — dist still emits es/index.html, and the host still serves
 * both spellings. Only what the page DECLARES about itself changes.
 */
const canonicalUrl = canonical ?? (redirectTo
  ? new URL(redirectTo, SITE.origin).href
  : new URL(outputPath ? urlOf(outputPath) : Astro.url.pathname, SITE.origin).href);

/**
 * The shell is written in English on every page, including the Spanish ones.
 * Declaring the document `es` and leaving the chrome undeclared would hand a
 * screen reader "Skip to content" and "Instagram" to pronounce as Spanish, which
 * is the same defect one level down. So the chrome states its own language
 * whenever it differs from the document's, and says nothing when it does not.
 */
const chromeLang = lang === 'en' ? undefined : 'en';

/**
 * ONE SCREEN SURFACE. Dark is not a theme, a default or a preference — it is
 * what this site is made of, and there is nothing to switch to.
 *
 * There was a second shell. `shell-paper` swapped the surface and ink tokens
 * for a cream page and was reached by `surface: paper` in a record's
 * frontmatter. Nine documentation articles used it, which meant the docs were
 * the one part of the site that turned white under you — MW-16 is the owner
 * asking for that to stop. Once those nine moved, the paper shell rendered on
 * zero of 195 pages: a whole second surface, its token block, and a branch in
 * every page's layout, kept alive for nobody. The owner's call was to remove it.
 *
 * PRINTING STILL GETS PAPER, and that is a different thing. `@media print` in
 * tokens.css swaps the same values for actual paper, where a black page is a
 * cartridge. That block stays and is now the only place those values live.
 *
 * `data-surface` stays on the element even though it can only say one word:
 * `verify:a11y` groups its contrast measurements by it, and the styles read
 * `:root`.
 */
const Shell = ShellDark;
const globalLanguageChoices = languageChoices ?? [
  { lang: 'en', label: 'english', current: lang === 'en', unavailable: lang !== 'en' },
  { lang: 'es', label: 'español', current: lang === 'es', unavailable: lang !== 'es' },
];
---

<!doctype html>
<html lang={lang} data-surface="dark" style={`--area-pigment: ${AREAS[area].pigment}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    {/* Icons. Production served 21 of these URLs across three origins and the
        build emitted none, so an already-saved bookmark or home-screen shortcut
        lost its icon at cutover — a silent break, like the feed.

        Order matters: a browser takes the LAST `rel="icon"` it understands, so
        the SVG comes after the PNGs and modern browsers get the one that
        follows the viewer's theme. `favicon.ico` carries no `sizes` and is
        found by browsers that only ever look at /favicon.ico anyway.

        `mask-icon` is Safari's pinned tab. Its `color` is the palette's sky —
        the file itself is a silhouette and Safari colours it from here, which
        is why that asset is monochrome by design. */}
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#a9d5e8" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#100f14" />
    <link rel="canonical" href={canonicalUrl} />
    {
      /* Self-referential too: `rel=alternate` sets are only valid if every page
         in the set lists every page in the set, including itself. Omitting the
         self link is the most common way these are got wrong. */
      alternates.length > 0 && (
        <>
          <link rel="alternate" hreflang={lang} href={canonicalUrl} />
          {alternates.map((a) => (
            <link
              rel="alternate"
              hreflang={a.lang}
              href={new URL(urlOf(a.outputPath), SITE.origin).href}
            />
          ))}
        </>
      )
    }
  </head>
  <body>
    <Shell
      area={area}
      chromeLang={chromeLang}
      contentWidth={contentWidth}
      languageChoices={globalLanguageChoices}
      navPaths={navPaths}
    >
      <slot />
    </Shell>
  </body>
</html>
