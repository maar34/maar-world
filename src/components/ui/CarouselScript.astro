---
/**
 * ui/carousel — the part that needs a script, and the amendment that allows it.
 *
 * MW-7 allowed application JavaScript on exactly one page. It now allows this
 * component as well, on the owner's decision, after two no-script attempts
 * failed for the same structural reason: §06 asks for prev/next that are
 * "disabled, not hidden" at the ends, "arrow keys move one slide, home and end
 * jump to the ends", and "the counter in a polite live region". A stylesheet
 * cannot do any of those. The first attempt faked them with eleven numbered
 * in-page links per gallery and was rejected outright; the second removed them
 * and left a track with no affordance.
 *
 * THE ENGINE IS EMBLA — the same one shadcn/ui's carousel is built on, taken as
 * its framework-free core. That keeps every invariant except the one being
 * amended: no React (the Helix island is still the only one), no Tailwind, and
 * no third-party request on page load, because Vite bundles it out of
 * node_modules and serves it from this origin.
 *
 * IT RENDERS NO MARKUP. The carousels are written into page bodies by
 * scripts/migrate-pages.mjs — see lib/carousel.mjs — so this component exists
 * only to carry the script, and `[...page].astro` includes it exactly on the
 * pages whose body has a carousel in it. Five pages load it; the other 129 ship
 * no JavaScript at all, which is the rule the amendment is narrowing, not
 * abandoning.
 */
---

<script>
  import EmblaCarousel from 'embla-carousel';

  /**
   * "all motion is suppressed under prefers-reduced-motion, including the orbit
   * and every carousel transition" — so the slide jumps rather than travels.
   * Embla's `duration` is its own unit, not milliseconds; 0 is an instant jump.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  /** A slide index, said the way the live region should say it. */
  const say = (i: number, n: number) => `Slide ${i + 1} of ${n}`;

  for (const root of document.querySelectorAll<HTMLElement>('.carousel')) {
    const track = root.querySelector<HTMLElement>('.carousel__track');
    if (!track) continue;

    const count = track.querySelectorAll('.carousel__slide').length;
    /* A carousel of one is not a carousel — the migration already declines to
       build one, and this declines to drive one. */
    if (count < 2) continue;

    /**
     * Embla owns a viewport whose first child is the track it translates, and
     * the no-script markup has no such element — deliberately, because a
     * wrapper that exists only for a library has no business in the emitted
     * HTML. It is created here, so the static page stays exactly what it was.
     */
    const viewport = document.createElement('div');
    viewport.className = 'carousel__viewport';
    track.before(viewport);
    viewport.append(track);

    /* Stand the native scroller down only once Embla is actually driving. */
    root.classList.add('carousel--live');

    const embla = EmblaCarousel(viewport, {
      /**
       * LOOP, on the owner's ask, and it supersedes one line of §06.
       *
       * The spec says "at the first or last slide the matching control is
       * disabled, not hidden" — but a looping track has no first or last, so
       * there is no end for a control to be disabled at. The buttons stay live
       * and the dots carry position instead. Recorded rather than quietly
       * dropped: `ledger -- find carousel-loop-supersedes-disabled`.
       */
      loop: true,
      /* Centre, because the centre slide is the one that is scaled up and lit.
         With `start` the emphasised slide would sit against the left edge. */
      align: 'center',
      /* The photographs are not one width — five of the eleven on the home page
         are square and six are 3:2 — and Embla measures the real slides, so a
         mixed set keeps its own widths. `containScroll` must be off for a loop;
         it exists to stop over-scroll at ends this track does not have. */
      containScroll: false,
      duration: reduced.matches ? 0 : 25,
    });

    /* ---- controls ------------------------------------------------------- */

    /**
     * TWO ROUND ARROWS, ONE ON EACH SIDE OF THE PICTURES.
     *
     * The version this replaces put a boxed `prev`, ten circles and a boxed
     * `next` in a row under the track. Three faults, all the owner's and all
     * fair: it read as one connected widget rather than as two controls, it sat
     * directly above the unrelated lab/live/bookings links so the two became a
     * single cluster of boxes, and the dots were noise on a page that has no
     * other row of circles anywhere.
     *
     * A carousel's controls belong beside the thing they move. These are
     * absolutely positioned against the carousel and vertically centred on the
     * image band, so nothing is added below the track at all.
     */
    const chevron = (d: string) =>
      `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">` +
      `<path d="${d}" fill="none" stroke="currentColor" stroke-width="1.6" ` +
      `stroke-linecap="round" stroke-linejoin="round"/></svg>`;

    const arrow = (side: 'prev' | 'next', label: string, path: string) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `carousel__arrow carousel__arrow--${side}`;
      /* The glyph is decorative, so the name is an attribute rather than text.
         No icon font — the theme's Font Awesome is gone and is not coming back. */
      b.setAttribute('aria-label', label);
      b.innerHTML = chevron(path);
      return b;
    };

    const prev = arrow('prev', 'Previous slide', 'M15 5 L8 12 L15 19');
    const next = arrow('next', 'Next slide', 'M9 5 L16 12 L9 19');

    /**
     * "the counter in a polite live region."
     *
     * Announced and never painted. The owner's verdict on the first version —
     * "we have numbers, we have numbers everywhere" — was about eleven numbered
     * boxes drawn under every gallery, and printing "3 of 10" would be the same
     * mistake in smaller type. A screen reader still gets the position, which
     * is the only place the spec asks for it.
     */
    const counter = document.createElement('p');
    counter.className = 'carousel__counter';
    counter.setAttribute('aria-live', 'polite');
    counter.textContent = say(embla.selectedScrollSnap(), count);

    root.append(prev, next, counter);

    /* ---- state ---------------------------------------------------------- */

    /* No disabled state on either arrow: the track loops, so neither is ever at
       an end. See the `loop` option above for why that overrides §06's rule. */
    const sync = () => {
      counter.textContent = say(embla.selectedScrollSnap(), count);
    };

    /**
     * THE CENTRE SLIDE GROWS AND LIGHTS UP.
     *
     * Embla's own scale/opacity examples, condensed into one pass: for each
     * snap, how far it is from the current scroll position decides both the
     * scale and the fade of the slides on it. The stylesheet owns the two
     * values; this only writes where along them each slide sits.
     *
     * The loop correction is the fiddly part and it is not optional. On a
     * looping track Embla moves slides across the seam, so a slide that has
     * just wrapped reads as maximally distant and would flash dark at the exact
     * moment it becomes the centre one. `loopPoints` says which slides are
     * currently displaced and by how far, so the distance is measured to where
     * the slide is DRAWN rather than to where its index says it is.
     */
    const clamp = (n: number, min: number, max: number) => Math.min(Math.max(n, min), max);
    const FADE_FLOOR = 0.35;
    const SCALE_FLOOR = 0.82;

    const tween = (eventName?: string) => {
      /* Suppressed entirely under reduced motion — every slide stays full size
         and fully lit, which is the readable state. */
      if (reduced.matches) return;

      const engine = embla.internalEngine();
      const progress = embla.scrollProgress();
      const inView = embla.slidesInView();
      const nodes = embla.slideNodes();
      const isScroll = eventName === 'scroll';

      /* Read live rather than captured at init: `reInit` fires when the images
         land and change the slide widths, which can change the snap count. */
      const snapList = embla.scrollSnapList();

      snapList.forEach((snap, snapIndex) => {
        let distance = snap - progress;

        for (const slideIndex of engine.slideRegistry[snapIndex]) {
          if (isScroll && !inView.includes(slideIndex)) continue;

          if (engine.options.loop) {
            for (const point of engine.slideLooper.loopPoints) {
              const target = point.target();
              if (point.index !== slideIndex || target === 0) continue;
              if (Math.sign(target) === -1) distance = snap - (1 + progress);
              if (Math.sign(target) === 1) distance = snap + (1 - progress);
            }
          }

          /* 0 at the centre, 1 by the time a slide is a full viewport away. */
          const away = clamp(Math.abs(distance) * snapList.length * 0.5, 0, 1);
          const slide = nodes[slideIndex];
          slide.style.setProperty('--slide-fade', String(1 - away * (1 - FADE_FLOOR)));
          slide.style.setProperty('--slide-scale', String(1 - away * (1 - SCALE_FLOOR)));
        }
      });
    };

    embla
      .on('select', sync)
      .on('reInit', sync)
      .on('reInit', () => tween())
      .on('scroll', () => tween('scroll'))
      .on('slideFocus', () => tween());
    sync();
    tween();

    /**
     * RE-MEASURE WHEN THE PHOTOGRAPHS ARRIVE.
     *
     * Embla measures slide widths once, at init. These slides are sized by
     * their image — the frame fixes height and the width follows, because the
     * set is mixed and nothing is cropped — so before the images load a slide
     * has no width to measure and every snap point is wrong. It showed as the
     * track visibly re-seating itself a moment after the page settled.
     *
     * No `width`/`height` attributes on these images to measure from instead:
     * they are written by the migration out of the legacy body, which had none.
     */
    const media = track.querySelectorAll<HTMLImageElement | HTMLVideoElement>('img, video');
    let queued = 0;
    const remeasure = () => {
      window.clearTimeout(queued);
      queued = window.setTimeout(() => embla.reInit(), 50);
    };
    for (const m of media) {
      const settled = m instanceof HTMLImageElement ? m.complete : m.readyState > 0;
      if (settled) continue;
      m.addEventListener('load', remeasure, { once: true });
      m.addEventListener('loadedmetadata', remeasure, { once: true });
      /* A photograph that fails still has to stop holding the track's geometry
         hostage — its slide collapses, and the remaining snaps must be right. */
      m.addEventListener('error', remeasure, { once: true });
    }

    prev.addEventListener('click', () => embla.scrollPrev());
    next.addEventListener('click', () => embla.scrollNext());

    /* Only explicitly opted-in carousels advance on their own. This is the
       homepage collage field: its images are decorative, it pauses for any
       pointer or keyboard interaction, and reduced-motion users never get
       auto-advance. Content carousels remain entirely visitor-driven. */
    const autoplayMs = Number(root.dataset.autoplay);
    let autoplay = 0;
    const stopAutoplay = () => window.clearInterval(autoplay);
    /**
     * A CAROUSEL THAT IS NOT RENDERED DOES NOT ADVANCE, and that guard arrived
     * with `patterns/VersionSwitch`. Before it, every carousel on this site was
     * always on screen and `document.hidden` covered the only way one could be
     * invisible — a background tab. A switch panel is the other way: the
     * `/orbiters` carousel now sits inside version one, which is `display: none`
     * until someone presses the tab, and without this it spent every visit
     * advancing a carousel nobody could see and then opening on whatever slide
     * the interval happened to have reached.
     *
     * `getClientRects()` is the test for "has a box", which is the actual
     * question — unlike `offsetParent`, which is also null for a fixed-position
     * element that is perfectly visible.
     */
    const rendered = () => root.getClientRects().length > 0;
    const startAutoplay = () => {
      stopAutoplay();
      if (!autoplayMs || reduced.matches || document.hidden || !rendered()) return;
      autoplay = window.setInterval(() => embla.scrollNext(), autoplayMs);
    };
    root.addEventListener('pointerenter', stopAutoplay);
    root.addEventListener('pointerleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);
    document.addEventListener('visibilitychange', startAutoplay);
    /**
     * The signal for a panel opening. None of the listeners above fire when a
     * stylesheet stops hiding an ancestor — there is no event for that — but the
     * element goes from no box to a box, which is exactly what a ResizeObserver
     * reports. A carousel that is always visible fires this once on observe and
     * behaves as it always has.
     */
    if (typeof ResizeObserver === 'function') {
      new ResizeObserver(() => (rendered() ? startAutoplay() : stopAutoplay())).observe(root);
    }
    startAutoplay();

    /**
     * "arrow keys move one slide, home and end jump to the ends."
     *
     * On the track, which already carries `tabindex="0"` from the migration and
     * was the keyboard route when this was a native scroller. Taking the
     * scroller away would otherwise have taken the keys with it.
     */
    track.addEventListener('keydown', (event) => {
      const keys: Record<string, () => void> = {
        ArrowLeft: () => embla.scrollPrev(),
        ArrowRight: () => embla.scrollNext(),
        Home: () => embla.scrollTo(0),
        End: () => embla.scrollTo(count - 1),
      };
      const move = keys[event.key];
      if (!move) return;
      event.preventDefault();
      move();
    });

    /* A visitor can turn reduced motion on while the page is open. */
    reduced.addEventListener('change', () => {
      embla.reInit({ duration: reduced.matches ? 0 : 25 });
      startAutoplay();
    });
  }
</script>
