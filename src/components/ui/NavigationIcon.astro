---
/**
 * Locally bundled Material Symbols for the site navigation.
 *
 * The former header loaded Google's icon font on every visit. These official
 * SVG sources are compiled directly into the header. The paths inherit their
 * link's colour in hover and current-page states, with no mask support or
 * browser-specific URL parsing involved.
 *
 * The source list itself lives in `lib/nav-icons.mjs`, because a page heading
 * needs the same symbols as a mask and two import blocks naming the same files
 * is how the two sets drift apart.
 */
import { NAV_ICON_SVG } from '../../lib/nav-icons.mjs';
import type { NavigationIconName } from '../../config/site';

interface Props {
  name: NavigationIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const symbols = NAV_ICON_SVG as Record<NavigationIconName, string>;
---

<span class:list={['nav-icon', className]} aria-hidden="true" set:html={symbols[name]}></span>
