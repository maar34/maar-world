---
/**
 * patterns/card — §04, "the fundamental unit. five variants, one anatomy."
 *
 * `src/styles/card.css` draws it and holds every value; this file decides the
 * anatomy — which slots exist, in what order, and what a missing one does.
 *
 * ONE LINK TARGET. The spec: "the whole card is one link target; nothing inside
 * it is separately focusable except an explicit collect action." So the root
 * element is a single `<a>` and the title is an `<h3>` inside it rather than a
 * second link. The pattern this replaces on the collect indexes put one link on
 * the thumbnail and another on the title — every entry twice in the tab order,
 * both going to the same page. That is the accessibility half of the rule; the
 * visual half is that the whole field is the hit target.
 *
 * The heading level is a prop, not a constant. A card is a component and its
 * title's level depends on what encloses it — an h3 under an h2 year group, an
 * h2 in a bare grid. Hardcoding h3 would let `verify:a11y`'s "no page skips a
 * heading level" fail on a page that used it correctly.
 *
 * MISSING SLOTS DEGRADE, THEY DO NOT COLLAPSE. No cover renders the hatch
 * plate, which is what the spec's own samples draw an empty cover as. No
 * excerpt, no badges and no meta simply omit their elements. That matters more
 * than usual here: the 34 Sky Sounds thumbnails are a standing BLOCKED item, so
 * "no cover" is the common case today, not the edge one.
 */
import { markHeadingText, cardTiltClass } from '../../lib/mark.mjs';

type Variant = 'entry' | 'compact' | 'place' | 'collection' | 'feature' | 'article';

interface Props {
  variant?: Variant;
  href: string;
  title: string;
  /** Heading level for the title. See the note above on why this is a prop. */
  level?: 2 | 3 | 4;
  /** Cover image. Omit for the hatch plate — that is a designed state. */
  cover?: string;
  /**
   * WHAT THE COVER IS, WHICH DECIDES ITS SHAPE.
   *
   * `band` — the default and the spec's 3:2 — treats the cover as a crop out of
   * a larger picture, which is right for an editorial entry.
   *
   * `card` is for a cover that is a whole object photographed edge to edge: a
   * portrait card face. It takes the artwork's own ratio and is fitted rather
   * than cropped, because there is no part of a card you can cut off and still
   * be showing the card. The ratio is already a per-variant property in this
   * component — the spec sets 4:3 on compact and 16:9 on place — so this is
   * that same dial, turned by the caller instead of by the variant.
   */
  coverShape?: 'band' | 'card';
  /**
   * HOW THE PICTURE MEETS THE FRAME, independently of what shape the frame is.
   *
   * `cover` crops to fill and is right for a photograph — the frame is a crop
   * out of a larger scene, and the edges of a scene are not the scene.
   *
   * `contain` fits the whole picture inside the frame and paints a dark field
   * behind it. It is for a picture that is a whole designed object: the Lab's
   * workshop poster is a sheet with type on it, so cropping it cuts words off,
   * and it is a transparent PNG, so without the field the hatch plate shows
   * through its background and the sheet reads as damaged.
   *
   * Separate from `coverShape`, which answers a different question. `card`
   * already implies contain because a playing card has its own ratio; this is
   * the same dial for a picture whose ratio is not the frame's and must not be
   * cut anyway.
   */
  coverFit?: 'cover' | 'contain';
  /**
   * SCATTER THIS CARD — the deck arrangement, and the inverse of the default.
   *
   * Every card leans when you reach for it and sits square at rest. A scattered
   * card does the opposite: it rests at an angle and squares up when you point
   * at it, which is what a deck of physical cards on a table does.
   *
   * Opt-in per grid, because a deck is scattered and a table of contents is not.
   * The angle itself is frozen per card either way — see `cardTiltClass` in
   * lib/mark.mjs for the choosing, card.css and tokens.css for the values.
   */
  scatter?: boolean;
  /** Three covers for `collection`'s cover strip. */
  strip?: string[];
  /** The pigment badge — an area, a suit, a set. */
  badge?: string;
  /**
   * The badge's own pigment, where the set it names has one.
   *
   * Defaults to the area pigment, which is right for a badge naming the area
   * and useless for one naming a suit inside it — every Sky Sounds badge drew
   * the same collect green and told a reader nothing the URL had not. A caller
   * that knows the set's colour passes it; nothing else changes.
   */
  badgePigment?: string;
  /** The outline badge — a year, a count in words. "badges max two." */
  badgeOutline?: string;
  excerpt?: string;
  /** The meta line: kind, glyphs, reading time. */
  meta?: string;
  /**
   * THE META LINE THAT SITS ABOVE THE TITLE, and why it is a second slot
   * rather than `meta` moved.
   *
   * An editorial index dates its entries before it names them — the Lab design
   * draws "feb 02, 2026 ∷⌗ installations" between the cover and the title, and
   * a reader scanning a year group is reading down that column of dates. The
   * meta line under the excerpt answers a different question ("how long is
   * this?") and both exist on the same card there.
   *
   * Opt-in, so the twenty entry cards already shipped are byte-identical: no
   * caller that omits it renders an element. It takes markup rather than text
   * because the separator inside it is a `GlyphRun`, which is a component.
   */
  metaLeadHtml?: string;
  /**
   * The index numeral, drawn on the cover — §04, "index numeral top-left,
   * bodoni 34, 32% ink".
   *
   * A string and not a number because it is the caller's own counting and its
   * padding is the caller's own decision ("01", not "1"); and `aria-hidden`
   * when it renders, because it names a position in a grid rather than
   * anything about the entry. Reordering the grid must not change what a
   * screen reader hears.
   */
  numeral?: string;
  /**
   * THE STATE BADGE, BOTTOM-RIGHT OF THE COVER — §04's other cover slot.
   *
   * A word about this entry, on the picture: "pinned" on the Lab's lead. It is
   * on the cover rather than in the meta line because the meta line answers
   * "how long is this" and this answers "why is this one here" — which a
   * reader asks while looking at the picture, and which the Lab has to answer
   * as soon as the lead stops being the newest entry.
   *
   * It is NOT `aria-hidden`, unlike the numeral: the numeral names a position
   * in a grid and this says something true about the entry.
   */
  state?: string;
  /**
   * The badge's pigment. `tree` is ochre, the spec's growth-and-stamps role
   * and what the design draws "pinned" in; the default is the area's own.
   * "one pigment per component instance; never two pastels touching."
   */
  stateTone?: 'area' | 'tree';
  /**
   * The entry's tags, as flat chips beneath the excerpt.
   *
   * Chips, never links. Production linked each tag to `/lab.html?tag=X` and a
   * script hid the non-matching rows; MW-7 forbids that script, and a link that
   * lands on an unfiltered index and does nothing is worse than a label. They
   * are also outside the card's single link target for the same reason nothing
   * else inside it is focusable.
   */
  tags?: string[];
  /** `place` only — "meta as a definition list, never as prose." */
  facts?: { term: string; value: string }[];
  /** "unavailable states say why in words." Supplying a reason marks it so. */
  unavailable?: string;
  /** Seed for the title's type mark. Marks are permitted at card-cover level. */
  seed?: string;
  /**
   * `article` only — the lead entry, "one per page, full measure".
   *
   * The same anatomy as the grid card, laid out as a picture beside its text
   * instead of above it. It is a modifier and not the `feature` variant
   * because `card.feature` is a different card: display-scale title, marks,
   * tilt, no date line, no tags. The home page's feature must not change shape
   * because the Lab acquired a lead entry, and this is what keeps the two
   * apart.
   */
  wide?: boolean;
}

const {
  variant = 'entry',
  href,
  title,
  level = 3,
  cover,
  coverShape = 'band',
  coverFit = 'cover',
  scatter = false,
  strip,
  badge,
  badgePigment,
  badgeOutline,
  excerpt,
  meta,
  metaLeadHtml,
  numeral,
  state,
  stateTone = 'area',
  tags,
  facts,
  unavailable,
  seed,
  wide = false,
} = Astro.props;

const Title = `h${level}` as 'h2' | 'h3' | 'h4';

/**
 * Marks are permitted at card-cover level — the rules-of-use table allows two
 * there — but `card.compact` says "no cover title marks at this size", and the
 * spec draws no mark on `card.place`'s or `card.collection`'s title either.
 * Only entry and feature are marked, and only when a seed is supplied.
 *
 * `markHeadingText` refuses any title containing markup and returns it
 * unchanged, so a card title is never mis-nested.
 */
const marked = seed && (variant === 'entry' || variant === 'feature')
  ? markHeadingText(title, seed).html
  : null;

/**
 * THE FEATURE CARD IS THE ONE VARIANT THAT IS NOT A SINGLE COLUMN.
 *
 * "card.feature — one per page, full measure", drawn as a cover beside its text
 * and stacking "to image-over-text below 900px". Every other variant is a flex
 * column, so its slots are siblings and that is the whole anatomy. Two columns
 * needs one more thing: something for the text side to BE, or the badges land
 * in the cover's column and the title lands under the cover.
 *
 * That is not hypothetical. `.card--feature` was written as a two-column grid
 * over these same five flat children and had never been rendered by anything;
 * the first page to use it put the excerpt under the image and the meta line
 * beside it. The wrapper only exists for `feature` — a Fragment adds no element
 * for the other four — so the twenty entry cards already shipped are unchanged.
 */
const twoColumn = variant === 'feature' || (variant === 'article' && wide);
const Body = twoColumn ? 'div' : Fragment;
const bodyClass = twoColumn ? 'card__body' : undefined;
---

<a
  href={href}
  class:list={[
    'card',
    `card--${variant}`,
    coverShape === 'card' && 'card--cover-card',
    coverFit === 'contain' && 'card--cover-contain',
    variant === 'article' && wide && 'card--article-wide',
    /* EVERY card gets a frozen angle — leaning on hover is the default now, so
       there is nothing to opt into. `href` is the fallback seed because it is
       always present and unique per card, while `seed` is optional and exists
       for the title mark. Without a fallback the home grid, which passes no
       seed, would have been the one grid on the site that did not respond. */
    cardTiltClass(seed ?? href),
    scatter && 'card--scatter',
    unavailable && 'card--unavailable',
  ]}
  aria-disabled={unavailable ? 'true' : undefined}
>
  {
    /* `collection` shows a three-up strip where the others show one cover.
       Each cell is a `.card__cover`, so an empty one is the same hatch plate. */
    variant === 'collection' ? (
      <div class="card__strip">
        {[0, 1, 2].map((i) => (
          <div class="card__cover plate">
            {strip?.[i] && <img src={strip[i]} alt="" loading="lazy" decoding="async" />}
          </div>
        ))}
      </div>
    ) : (
      <div class="card__cover plate">
        {cover && <img src={cover} alt="" loading="lazy" decoding="async" />}
        {
          /* A COVER THAT IS DRAWN RATHER THAN PHOTOGRAPHED — §04's cover slot,
             filled by a component instead of a file. The Docs grid passes a
             `ui/DocGlyph` here (MW-16); nothing else uses it yet.

             A slot and not another string prop, because what goes in is markup
             with its own imports — the same reason `metaLeadHtml` exists, one
             step further. `Astro.slots.has` keeps every current caller
             byte-identical: a card that passes nothing renders no element.

             Second to `cover`, never instead of it. A record with a real
             photograph shows the photograph; the glyph is what a record with no
             picture worth showing gets, one step above the bare hatch plate. */
          !cover && Astro.slots.has('cover') && <slot name="cover" />
        }
        {
          /* §04, "index numeral top-left". Decorative: it names a position in
             a grid, not anything about the entry, so reordering the grid must
             not change what a screen reader hears. */
          numeral && (
            <span class="card__numeral" aria-hidden="true">
              {numeral}
            </span>
          )
        }
        {
          /* §04, "state badge bottom-right". NOT aria-hidden: unlike the
             numeral this says something about the entry, and on the Lab it is
             the only thing that explains why an older entry leads the page. */
          state && (
            <span class:list={['card__state', stateTone === 'tree' && 'card__state--tree']}>{state}</span>
          )
        }
      </div>
    )
  }

  <Body class={bodyClass}>
    {
      /* The date line, above the title — see `metaLeadHtml` above for why an
         index dates an entry before it names it. */
      metaLeadHtml && <p class="card__metalead" set:html={metaLeadHtml} />
    }

    {
      /* "badges max two" — the props allow exactly two and no more. */
      (badge || badgeOutline) && (
        <div class="card__badges">
          {badge && (
            <span
              class="card__badge card__badge--pigment"
              style={badgePigment ? `--card-badge-pigment: ${badgePigment}` : undefined}
            >
              {badge}
            </span>
          )}
          {badgeOutline && <span class="card__badge card__badge--outline">{badgeOutline}</span>}
        </div>
      )
    }

    {/* The feature card is the only one allowed to tilt, so it is the only one
        that wraps its title in a containing block to rotate. */}
    <Title class="card__title">
      {variant === 'feature' ? (
        <span class="card__tilt">{marked ? <Fragment set:html={marked} /> : title}</span>
      ) : marked ? (
        <Fragment set:html={marked} />
      ) : (
        title
      )}
    </Title>

    {facts && facts.length > 0 && (
      <dl class="card__dl">
        {facts.map((f) => (
          <div>
            <dt>{f.term}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {excerpt && <p class="card__excerpt">{excerpt}</p>}

    {
      /* Chips, not links — see `tags` above. A `ul` because it is a list of
         several, and `role="list"` because `list-style: none` takes the
         semantic away from VoiceOver otherwise. */
      tags && tags.length > 0 && (
        <ul class="card__tags" role="list">
          {tags.map((t) => (
            <li class="card__tag">{t}</li>
          ))}
        </ul>
      )
    }

    {/* The unavailable reason is text, never colour alone — the spec asks for it
        in words, and it replaces the meta line rather than sitting beside it. */}
    {unavailable ? <p class="card__meta">{unavailable}</p> : meta && <p class="card__meta">{meta}</p>}
  </Body>
</a>
