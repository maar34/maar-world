---
/**
 * mark.glyphs — the decorative separator.
 *
 * Replaces every `·` separator. A run of 2–4 glyphs drawn from the fixed set,
 * chosen at render and then frozen, always aria-hidden.
 *
 * "Frozen" is the load-bearing word: the spec requires that a run must not
 * reshuffle on re-render or on navigating back. So the run is derived
 * deterministically from a seed (the card code, the article slug) rather than
 * from Math.random — same seed, same glyphs, forever, with no state to persist.
 */

/**
 * THE SET IS WHAT DM MONO ACTUALLY SHIPS, AND IT WAS MEASURED.
 *
 * The spec's rule: "the set is restricted to glyphs dm mono ships, so runs
 * never fall back to another face." The set this file had — ⌁ ⋄ ⎔ ⌗ ⏣ ⍜ —
 * satisfied none of it. Measured in the browser against the bundled font by
 * comparing each glyph's advance to the monospace advance (9.6px at 16px, which
 * every glyph a monospace font contains shares):
 *
 *   ⌁ 9.63   ⋄ 6.09   ⎔ 12.01   ⌗ 10.66   ⏣ 10.66   ⍜ 9.63    — none is 9.6
 *
 * All six were being drawn by a fallback face in the middle of a DM Mono line,
 * which is the exact thing that rule exists to prevent, on all 46 marked
 * headings. The spec names five — ⌗ ≡ ∴ ∷ ⁂ — and the same measurement says
 * only three of those are in the font either:
 *
 *   ⌗ 10.66   ≡ 9.63   ∴ 9.6 ✓   ∷ 9.6 ✓   ⁂ 9.6 ✓
 *
 * So the set is those three. A run of two to four still reads as a run, and
 * every glyph in it is drawn by the face the line is set in. If ⌗ and ≡ are
 * wanted, the font subset has to carry them first — a set cannot name a glyph
 * and hope.
 */
const GLYPHS = ['∴', '∷', '⁂'] as const;

interface Props {
  seed: string;
}

const { seed } = Astro.props;

// FNV-1a — small, stable, and not sensitive to the platform's string hashing.
function hash(input: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < input.length; i += 1) {
    h ^= input.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h;
}

const h = hash(seed);
const length = 2 + (h % 3); // 2–4 glyphs
const run = Array.from({ length }, (_, i) => GLYPHS[(hash(`${seed}:${i}`) >>> 3) % GLYPHS.length]);
---

<span aria-hidden="true" class="glyph-run">{run.join('')}</span>

<style>
  .glyph-run {
    font-family: var(--t-meta-face);
    color: var(--ink-faint);
    letter-spacing: 0.18em;
    user-select: none;
  }
</style>
