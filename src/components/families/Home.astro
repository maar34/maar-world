---
/**
 * Page family 01 — home. §08: "one feature card, then three entry cards. no
 * sidebar."
 *
 * That sentence is the whole specification and this file is the whole of it: a
 * page header, a visual carousel header, `card.feature`, three `card.entry`,
 * and then whatever the body still holds. The carousel is deliberately not a
 * second card: it establishes the page’s opening atmosphere, while the feature
 * remains the first editorial destination and its only featured-card treatment.
 *
 * WHAT THIS FIXES. `/` was rendering as family 03 — "single measure, 66ch max"
 * — which is correct for an article and wrong for a landing. Everything the
 * owner listed as separate faults ("missing cards, carousels, a hero; the
 * content is narrower than the header") was that one substitution. The measure
 * is not widened to compensate; the family is changed, and 66ch goes on meaning
 * what it means on an entry page.
 *
 * NO SIDEBAR, and nothing is added to fill the width either. The column is
 * --content-max, the same 1180 the header and footer sit in, so the page reads
 * as one document rather than as chrome with a narrow article inside it.
 */
import Card from '../patterns/Card.astro';
import CollageField from '../patterns/CollageField.astro';
import PaperPhrase from '../patterns/PaperPhrase.astro';
import Action from '../ui/Action.astro';
import { articleCoverFor, collageFor, HOME_ACTIONS } from '../../config/site';

interface Feature {
  title: string;
  excerpt: string;
  href: string;
  meta?: string;
  cover?: string;
}

interface Entry {
  title: string;
  excerpt: string;
  href: string;
  meta?: string;
  cover?: string;
}

interface Props {
  /** The `<h1>`'s inner HTML. It already carries its type mark. */
  headingHtml?: string;
  /** Fallback when a record has no marked heading — the plain page title. */
  title: string;
  lede?: string;
  feature?: Feature;
  entries?: Entry[];
  tonguesLabel?: string;
  tongues?: string[];
  /** Seed for the feature title's type mark — the page's own outputPath. */
  seed: string;
}

const { headingHtml, title, lede, feature, entries = [], tonguesLabel, tongues = [], seed } =
  Astro.props;

const labelId = 'home-entries';
---

<div class="home">
  {/* The site name already lives in the global brand link; keep the page H1 for
      document structure while its opening image carousel does the visual work. */}
  <h1 class="home__title home__title--accessible">
    {headingHtml ? <Fragment set:html={headingHtml} /> : title}
  </h1>

  <CollageField
    src={collageFor('')!}
    statement={lede}
    statementSeed={`${seed}:statement`}
  />

  {
    /* The card remains one generous link target. Its two explicit next steps
       sit beside it rather than inside it, so no interactive element is nested
       inside another and the action system stays reusable. */
    feature && (
      <section class="home__feature" aria-label="Featured collection">
        <Card
          variant="feature"
          href={feature.href}
          title={feature.title}
          level={2}
          cover={feature.cover}
          excerpt={feature.excerpt}
          meta={feature.meta}
          seed={seed}
        />
        <nav class="home__actions" aria-label="Featured collection actions">
          {HOME_ACTIONS.map((action) => (
            <Action href={action.href} label={action.label} variant={action.variant} />
          ))}
        </nav>
      </section>
    )
  }

  {
    entries.length > 0 && (
      <section class="home__entries" aria-labelledby={tonguesLabel ? labelId : undefined}>
        {
          /* "work in progress" — the theme's own label for exactly these three
             cards, kept as the heading they sit under rather than left floating
             above them as a paragraph. */
          tonguesLabel && (
            <h2 class="home__label" id={labelId}>
              {tonguesLabel}
            </h2>
          )
        }

        {tongues.length > 0 && (
          <PaperPhrase phrases={tongues} seed={`${seed}:translations`} variant="translations" />
        )}

        {/* "cards: 1 / 1 / 2 / 3" across the four breakpoints — the responsive
            table's own counts, bound in the stylesheet below. */}
        <div class="home__grid">
          {entries.map((e) => (
            <Card
              variant="entry"
              href={e.href}
              title={e.title}
              level={3}
              cover={e.cover ?? articleCoverFor(e.href)}
              excerpt={e.excerpt}
              meta={e.meta}
            />
          ))}
        </div>
      </section>
    )
  }

  {/* Remaining authored prose only. Home media is structural content above,
      rather than an inherited video/image carousel inside a prose slot. */}
  <div class="prose">
    <slot />
  </div>
</div>

<style>
  /**
   * The page column. --content-max, not --measure: family 01 is not prose, and
   * this is the narrow answer to "the content is not the same width as the
   * header" — the header, the footer and this now share one column.
   */
  .home {
    padding-block: 0 var(--s-24);
    display: flex;
    flex-direction: column;
    /* "sibling groups use gap, never margins." */
    gap: var(--s-16);
  }

  /**
   * The display face at line-height 0.98 sets a line box SHORTER than its
   * glyphs, so the descenders hang below the element. `.prose h1` pays for that
   * overhang with --s-12 of bottom margin; here the flex gap above does the
   * same job, and the title's own margin is zeroed so the two do not add up.
   */
  .home__title {
    margin: 0;
  }

  /* The site name already has a persistent home in the global brand link. The
     H1 remains for document structure and assistive technology, without making
     the first visible homepage section repeat the header. */
  .home__title--accessible {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .home__entries {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .home__feature {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  /* The components carry their opposed lean; this group only establishes the
     shared rhythm and remains usable if a future page supplies one action. */
  .home__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-4);
  }

  .home__label {
    margin: 0;
  }

  /**
   * "breakpoint / cards: <600 → 1, 600–899 → 1, 900–1279 → 2, ≥1280 → 3."
   *
   * Written mobile-first in the same order and at the same widths as the gutter
   * bindings in styles/shell.css, so the two sets of breakpoints cannot drift.
   * Three cards in two columns leaves the third at column width rather than
   * stretched across — the count is the spec's, and a card that changes size
   * because of how many siblings it has is not the same component.
   */
  .home__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
  }

  @media (min-width: 900px) {
    .home__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .home__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
