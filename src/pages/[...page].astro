---
/**
 * Every migrated page, at the exact path the frozen route policy demands.
 *
 * Modelled on `[cardCode].astro`: `getStaticPaths` enumerates the collection, so
 * this route can only ever claim paths that a content record asked for. The
 * param is `outputPath` verbatim — never re-derived from a title, a slug or a
 * filename, because the whole point is that `/collect/cards/032_-maar-sky-
 * sounds.3-card X ` keeps its internal space *and* its trailing space.
 *
 * One file per page. The host serves `/x` and `/x.html` from the same `x.html`,
 * so both spellings resolve from a single emitted file and no twin is written.
 * Pages whose contract includes the literal `…/index.html` spelling carry an
 * `outputPath` ending `/index` for exactly that reason.
 *
 * Layout is page family 03 (entry) as used by the card pages: single measure,
 * h1 may carry marks, nothing below it does.
 *
 * THE BODY WRAPPER IS `.prose`, AND IT IS NOT A MIGRATION ARTIFACT. Every page
 * this route renders goes through it — a migrated body and an authored one
 * alike — so it is the reading treatment of every page that will ever exist
 * here, including posts not yet written. It was called `.legacy` and that name
 * caused a bug: the rhythm of every page body was filed under a word meaning
 * "temporary", nobody audited it for completeness, and `h1` was left out of the
 * list of headings it styled. Two stylesheets now split by lifetime —
 * `styles/prose.css` is permanent and checked for completeness by
 * `verify:build`; `styles/legacy.css` holds only rules keyed to the dead
 * theme's class names and is deleted whole when the migration stops emitting
 * them.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlyphRun from '../components/patterns/GlyphRun.astro';
import TypeMark from '../components/patterns/TypeMark.astro';
import Stamp from '../components/patterns/Stamp.astro';
import Card from '../components/patterns/Card.astro';
import Home from '../components/families/Home.astro';
import HelixIsland from '../components/react/HelixIsland.astro';
import { languageChoices, alternatesFor } from '../lib/translations.mjs';
import { stampText } from '../lib/mark.mjs';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const byPath = new Map(pages.map((p) => [p.data.outputPath, p]));

  return pages.map((entry) => ({
    // Byte-for-byte. No trimming, no slugifying, no case folding.
    params: { page: entry.data.outputPath },
    props: { entry, all: [...byPath.values()] },
  }));
}

const { entry, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

/**
 * `{% include article-list.html %}` used to render these.
 *
 * Membership comes from `indexGroup` — the legacy Jekyll collection the record
 * was migrated out of — not from `kind`, which is derived from the URL. The two
 * are not the same set: `/collect/privacy` belongs to `site.documentation` but
 * is published at the site root, so a URL-derived filter left it out and the
 * Documentation index rendered nine entries where production renders ten.
 */
const listed = d.indexOf ? all.filter((p) => p.data.indexGroup === d.indexOf) : [];

/**
 * Dated collections (the Lab) read newest first. Undated ones fall through to
 * `indexOrder`, the collection-relative source path, which is the order Jekyll
 * itself rendered — `03-ent-cards.md` before `03-ent-cards/01-sustainability.md`
 * because `.` sorts before `/`.
 */
const sorted = [...listed].sort((a, b) => {
  const da = String(a.data.date ?? '');
  const db = String(b.data.date ?? '');
  if (da !== db) return db.localeCompare(da);
  const oa = String(a.data.indexOrder ?? '');
  const ob = String(b.data.indexOrder ?? '');
  if (oa !== ob) return oa.localeCompare(ob);
  return a.data.outputPath.localeCompare(b.data.outputPath);
});

/**
 * dist-relative outputPath → the URL a browser asks for.
 *
 * Percent-encoded, because one Collect card path ends in a space and an href
 * with a trailing literal space is not reliably preserved by anything that
 * touches it — including HTML parsers. `%20` is the spelling the frozen
 * manifest itself records, so this is the contract's own form, not a tidy-up.
 */
const hrefOf = (outputPath: string) =>
  encodeURI(`/${outputPath.replace(/(^|\/)index$/, '')}`.replace(/\/(?=$)/, '')) || '/';

const isCard = d.kind === 'collect-card';

/**
 * A covered index renders patterns/card in a grid — page family 04's shape —
 * so it is not bound by family 03's prose measure. See the page container.
 */
const isCardGrid = Boolean(d.indexCovers);

/**
 * The language switcher, and the <link rel="alternate"> set.
 *
 * Empty for the 75 pages that exist in one language only — a switcher offering
 * one choice is a label, not a control, and rendering it would suggest a
 * Spanish version exists where none does.
 *
 * This replaces the two buttons the legacy body carried at /lab
 * (`?tag=EN` / `?tag=ES`). Those pointed at query-string filters on a static
 * build with no JavaScript, so both served the identical unfiltered page: a
 * visible, clickable, inert control. They are stripped by the migration now.
 */
const langChoices = languageChoices(entry, all);
const alternates = alternatesFor(entry, all);

/**
 * The Lab reads as a dated bibliography, not a list of links, so it groups by
 * year with a rule per group — the spec's page family 02, and what production
 * served. Every other index is a flat list of titles.
 *
 * Grouping is derived from the records rather than declared, so nothing has to
 * be updated when a year rolls over.
 */
const isYearIndex = d.indexOf === 'lab';

const byYear: [string, typeof sorted][] = isYearIndex
  ? [
      ...sorted
        .filter((p) => p.data.date)
        .reduce((acc, p) => {
          const year = String(p.data.date).slice(0, 4);
          acc.set(year, [...(acc.get(year) ?? []), p]);
          return acc;
        }, new Map<string, typeof sorted>())
        .entries(),
    ].sort((a, b) => b[0].localeCompare(a[0]))
  : [];

/** "25 Aug 2023" — the form the legacy index printed under each title. */
const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
const readableDate = (iso: string) => {
  const [y, m, day] = iso.split('-');
  return `${MONTHS[Number(m) - 1]} ${day.padStart(2, '0')}, ${y}`;
};
---

<BaseLayout
  title={d.title}
  description={d.description ?? d.card_description}
  surface={d.surface}
  noindex={d.noindex}
  area={d.area}
  lang={d.lang}
  alternates={alternates.map((p) => ({ lang: p.data.lang, outputPath: p.data.outputPath }))}
  redirectTo={d.redirectTo}
>
  {
    /**
     * PAGE FAMILY 01 — home. §08 gives it one sentence: "one feature card, then
     * three entry cards. no sidebar."
     *
     * Everything below this branch is family 03, entry — "single measure, 66ch
     * max" — and that is the right default for a document. It was the wrong
     * thing for `/`, which is a landing and not an article, and every symptom
     * the owner listed followed from the substitution. So the fix is a family,
     * not a width: `.measure` still means 66ch everywhere it applies.
     *
     * The dispatch is `family`, a schema enum, not `outputPath === 'index'`.
     * Nine more skeletons are specified and four of them are card grids; a
     * chain of URL comparisons is the thing to have avoided starting.
     */
    d.family === 'home' && (
      <Home
        headingHtml={d.headingHtml}
        title={d.indexLabel ?? d.title}
        lede={d.lede}
        feature={d.feature}
        entries={d.entries}
        tonguesLabel={d.tonguesLabel}
        tongues={d.tongues}
        seed={d.outputPath}
      >
        <Content />
      </Home>
    )
  }

  {!d.family && (
  <Fragment>
  {/* The shell owns <main>. This is the page family inside it.

      THE MEASURE IS FAMILY 03's, NOT EVERY PAGE'S. "03 entry — single measure,
      66ch max" is the rule for an article, and it is why a lab post reads at a
      sane line length. A covered index is not an article: family 04 collection
      is "two-up card grid", and a two-up grid inside a 66ch column is a one-up
      grid — measured, 644px of column against the 664px two 20rem cards and a
      gap need.

      So a card grid takes the full content column, which is the same 1180 the
      header and footer use. This is also the narrow answer to "the width of the
      content is not the same as the width of the header": it is correct for an
      entry page and wrong for an index, and only the index changes. */}
  <div class:list={['page', 'shell__inner', !isCardGrid && 'measure']}>
    {
      /* The label line, with no mark on it.
         The rules-of-use table permits marks at h1 and card-cover level and
         forbids them at body, ui, label and caption level — and this is a label
         line. The glyph run that used to sit here now sits in the h1 below,
         where up to two are allowed and where zero were being used. */
      isCard && (
        <p class="t-meta suit">
          <span>{d.suit_title}</span>
          <span>{d.card_title}</span>
        </p>
      )
    }

    {
      /* Two marks, which is the h1 maximum: the glyph run, and one word of the
         title cut out of a different sheet. Below 600px the responsive table
         allows one, so `h1--marked-glyphs` stands the cut word down there and
         leaves the run — it is already aria-hidden and carries no word.
         Both are decoration: the accessible name is the card title alone. */
      isCard && (
        <h1 class="h1--marked-glyphs">
          <TypeMark text={d.card_title} seed={d.outputPath} />
          {' '}
          <GlyphRun seed={d.outputPath} />
        </h1>
      )
    }

    {
      /* One mark at card-cover level, where the table allows two and nothing was
         spending them: the edition numeral, stamped on the mount rather than on
         the artwork. See src/components/patterns/Stamp.astro for why not over
         the image. `cover--stamped` opens the mount only on the covers that have
         one, so a card with no numeral is laid out exactly as it was. */
      isCard && d.card_image && (
        <figure class:list={['cover', 'plate', stampText(d.card_title) && 'cover--stamped']}>
          <Stamp cardTitle={d.card_title} />
          <img src={d.card_image} alt={`${d.suit_title} ${d.card_title}`} loading="lazy" decoding="async" />
        </figure>
      )
    }

    {isCard && d.card_description && <p class="description">{d.card_description}</p>}

    {
      /* One link per language, the current one marked with aria-current rather
         than by colour alone. It is a nav landmark so a screen-reader user can
         reach it directly, and each link declares the language it leads TO —
         `hreflang` for machines, `lang` so the label "español" is pronounced
         as Spanish rather than read with English phonemes. */
      langChoices.length > 1 && (
        <nav class="lang-switch" aria-label="Language">
          <ul role="list">
            {langChoices.map((c) => (
              <li>
                <a
                  href={hrefOf(c.outputPath)}
                  hreflang={c.lang}
                  lang={c.lang}
                  aria-current={c.current ? 'page' : undefined}
                >
                  {c.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      /* The single approved island. Astro emits JavaScript only for pages that
         mount one, so this branch is also the reason every other page in the
         build ships none. */
      d.island === 'helix' && <HelixIsland />
    }

    {
      /* play.maar.world shares the registrable domain, so it is same-site even
         inside an iframe and needs no click-to-load facade. */
      isCard && d.snip_player && (
        <iframe src={d.snip_player} title={`${d.suit_title} ${d.card_title} player`} loading="lazy" class="player" />
      )
    }

    {
      /* The year-grouped index — the Lab's shape.
         This used to be ~104 lines of literal HTML baked into the body of
         lab.md by the migration, derived from the read-only legacy checkout.
         A post that was not in that checkout could not appear here. It is now
         rendered from the collection, so a page written into
         src/content/authored/ shows up with no script run at all.
         The row markup is deliberately the shape production served: an <h2>
         per year, an <h3> per article, a <time>, the excerpt and the tags. */
      byYear.length > 0 && (
        <div class="index index--lab">
          {byYear.map(([year, rows]) => (
            <section class="index-year" aria-labelledby={`lab-${year}`}>
              <h2 class="index-year__label" id={`lab-${year}`}>{year}</h2>
              <hr class="index-year__rule" />
              <ul class="index-rows" role="list">
                {rows.map((p) => (
                  <li class="index-row" lang={p.data.lang}>
                    <h3 class="index-row__title">
                      <a href={hrefOf(p.data.outputPath)}>{p.data.indexLabel ?? p.data.title}</a>
                    </h3>
                    <time class="index-row__date" datetime={String(p.data.date).slice(0, 10)}>
                      {readableDate(String(p.data.date).slice(0, 10))}
                    </time>
                    {p.data.description && <p class="index-row__excerpt">{p.data.description}</p>}
                    {p.data.tags?.length > 0 && (
                      <ul class="index-row__tags" role="list">
                        {p.data.tags.map((t: string) => (
                          <li class="index-row__tag">{t}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }

    {
      /**
       * A covered index is a CARD GRID — patterns/card, §04 — and this is the
       * component's first consumer.
       *
       * What it replaces put a link on the thumbnail AND a link on the title of
       * every row, both going to the same page: every entry twice in the tab
       * order and twice to a screen reader, with the first one `aria-hidden`
       * and `tabindex="-1"` to paper over it. The spec settles that outright —
       * "the whole card is one link target" — so the card is one `<a>` and the
       * problem stops existing rather than being suppressed.
       *
       * THE COVER IS `cover`, NEVER `card_image`. These records carry both, and
       * `card_image` is a dropbox.com URL: rendering 34 of them here would take
       * the on-load third-party count from 73 to 107, and that number must
       * never go up. `cover` is the (currently missing) thumbnail, so most of
       * these render the hatch plate — which is exactly what the spec draws an
       * empty cover as, and what the lost-thumbnails BLOCKED item looks like
       * until a human resolves it.
       *
       * An uncovered index stays a list of links. It is a list of links.
       */
      sorted.length > 0 && !isYearIndex && d.indexCovers && (
        <div class="card-grid">
          {sorted.map((p) => (
            <Card
              variant="entry"
              href={hrefOf(p.data.outputPath)}
              title={p.data.indexLabel ?? p.data.title}
              level={2}
              cover={p.data.cover}
              badge={p.data.suit_title}
              badgeOutline={p.data.date ? String(p.data.date).slice(0, 4) : undefined}
              excerpt={p.data.card_description ?? p.data.description}
              meta={p.data.lang}
              seed={p.data.outputPath}
            />
          ))}
        </div>
      )
    }

    {
      sorted.length > 0 && !isYearIndex && !d.indexCovers && (
        <ul role="list" class="index-list">
          {sorted.map((p) => (
            <li>
              <a href={hrefOf(p.data.outputPath)}>{p.data.title}</a>
              {p.data.date && <span class="t-meta"> {String(p.data.date).slice(0, 10)}</span>}
              {p.data.lang && <span class="t-meta"> {p.data.lang}</span>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
  </Fragment>
  )}
</BaseLayout>

<style>
  /* The language switcher. A row of links, the current one carrying the same
     pigment field the header uses for the current area — pigment plus
     aria-current plus an underline, because a pigment field never carries
     meaning alone. */
  .lang-switch ul {
    display: flex;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /**
   * OPPOSED CHIPS — mark 5, and only the half of it that is settled.
   *
   * 4a's pair is "one filled, one outlined, and they tilt in opposite
   * directions". The fill-against-outline half is shipped here because it is
   * the spec's own chip table — rest is `1px solid` ink at 20%, selected is a
   * field — and 4a's `en`/`es` pair is that table drawn in the language
   * switcher. Before this, a non-current language was plain meta text and the
   * pair did not read as two chips at all.
   *
   * THE OPPOSITION now ships too. It was held for a session on a reading of the
   * rules-of-use table's "ui — tilt: never" row; the owner's correction is that
   * the no-rotation rule was only ever about `mark.highlight`. The angles are
   * 4a's own `en`/`es` pair — the selected chip at -1.5deg against the resting
   * one at +1deg — and they are steeper than the buttons because 4a's are: a
   * chip is small enough that a degree barely reads on it.
   *
   * The transparent border on the base rule is not padding fiddling: it keeps
   * the filled and the outlined chip the same box, so the row does not shift by
   * a pixel when the current language changes.
   */
  .lang-switch a {
    display: inline-block;
    padding-inline: var(--s-2);
    border: 1px solid transparent;
    border-radius: var(--r-0);
    font-family: var(--t-meta-face);
    font-size: var(--t-meta-size);
    line-height: var(--t-meta-line);
    letter-spacing: var(--t-meta-track);
    text-decoration: none;
    color: var(--ink-meta);
  }

  /* Rest — the outlined chip, leaning one way. */
  .lang-switch a:not([aria-current]) {
    border-color: var(--chip-rule);
    transform: rotate(var(--chip-tilt-rest));
  }

  /* Selected — the filled chip, leaning the other. The field is not the only
     carrier: aria-current and the underline say it too. */
  .lang-switch a[aria-current] {
    background: var(--area-pigment, var(--c-maar));
    color: var(--pigment-ink);
    text-decoration: underline;
    transform: rotate(var(--chip-tilt-selected));
  }

  /**
   * "< 600 … tilt max --tilt-b".
   *
   * -1.5deg is outside the cap, so below 600px the selected chip comes back to
   * --tilt-b. The resting chip is already at 1deg and is left alone: the pair
   * still leans apart, just less far. Reducing rather than removing, for the
   * reason the stamp does — a chip that stands fully upright stops being one of
   * an opposed pair.
   */
  @media (max-width: 599px) {
    .lang-switch a[aria-current] {
      transform: rotate(var(--tilt-b));
    }
  }

  /* Hover fills, so the edge joins the field rather than ruling a line through
     the middle of it. */
  .lang-switch a:hover {
    background: var(--area-pigment, var(--c-maar));
    border-color: var(--area-pigment, var(--c-maar));
    color: var(--pigment-ink);
  }

  /* Page family 03 — entry. Single measure.
     The measure is --measure (66ch), not 72ch: "prose measure never exceeds
     66ch at any width". The horizontal padding is the shell's responsive
     gutter, which .shell__inner supplies. */
  .page {
    padding-block: var(--s-16) var(--s-24);
    display: flex;
    flex-direction: column;
    /* Sibling groups use gap, never margins. Space is the primary separator. */
    gap: var(--s-6);
  }

  .suit {
    color: var(--ink-meta);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
  }

  /* The plate is the hatch, not the flat tint it used to be — mark 7. The
     class carries it, so the value lives in tokens.css and nothing here
     reaches for a texture directly. */
  .cover {
    margin: 0;
    border-radius: var(--r-0);
  }

  /**
   * The mount the stamp is pressed on.
   *
   * `.cover` has always carried --sf-raised, and nothing has ever seen it: the
   * image fills the figure edge to edge. A stamped cover opens that field by
   * --s-2 on every side and puts the stamp in its top-right corner, so the mark
   * sits on a flat surface whose contrast can be asserted rather than on a
   * photograph whose contrast is whatever that card happens to be.
   *
   * Only stamped covers get the mount, so a card with no edition numeral — the
   * one WildCard — is laid out exactly as it was.
   */
  .cover--stamped {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-2);
    padding: var(--s-2);
  }

  /* `align-items: flex-end` is for the stamp; without this the image would
     shrink-wrap to its intrinsic width instead of filling the mount. */
  .cover--stamped img {
    align-self: stretch;
  }

  .cover img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .description {
    color: var(--ink-muted);
  }

  .player {
    width: 100%;
    min-height: 220px;
    border: 0;
    background: var(--sf-sunken);
    border-radius: var(--r-0);
  }

  .index-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .index-list .t-meta {
    color: var(--ink-meta);
  }

  /* A covered list is a grid of entries, not a run of lines. Two columns at
     reading width, one below it. No wash, no shadow: the plate is the surface
     token and the image sits flush on it. */
  .index-list--covers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--s-6);
  }

  /* `.plate` on the element carries the hatch and the radius. */
  .index-list__cover {
    display: block;
    margin-bottom: var(--s-2);
  }

  .index-list__cover img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-0);
  }

  /* ---- the year-grouped Lab index ---------------------------------------
   * First-party markup, rendered by this route from the collection — the
   * template is 30 lines above. It lived in `legacy.css` because the index used
   * to be ~104 lines of HTML baked into lab.md by the migration, and it stayed
   * there after the route took the job over.
   *
   * Which is how `.index-row__tag` came to be dead code: it kept the
   * `.legacy ` prefix while the element it names moved OUT of that wrapper, so
   * it matched nothing and the tags have been rendering as plain text. Scoped
   * to this component now, where the markup is, so a selector and the element
   * it targets cannot drift into different files again.
   */
  .index {
    display: flex;
    flex-direction: column;
    gap: var(--s-16);
  }

  .index-year {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  /* The rule above a year group — the second of the two places one is allowed. */
  .index-year__rule {
    margin-block: var(--s-2) 0;
  }

  .index-rows {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .index-row {
    display: flex;
    flex-direction: column;
    /* "sibling groups use gap, never margins." */
    gap: var(--s-2);
  }

  .index-row__title {
    margin: 0;
  }

  .index-row__date {
    color: var(--ink-meta);
    font-family: var(--t-meta-face);
    font-size: var(--t-meta-size);
    line-height: var(--t-meta-line);
    letter-spacing: var(--t-meta-track);
  }

  .index-row__excerpt {
    color: var(--ink-muted);
    margin: 0;
  }

  .index-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Tags are chips, not links: production linked each to `/lab.html?tag=X` and
     a script hid the non-matching rows; MW-7 forbids that script, and a link
     that lands on an unfiltered index and does nothing is worse than a label.
     A chip is a flat field with dark type on it. */
  .index-row__tag {
    background: var(--ink-tint);
    color: var(--ink-muted);
    border-radius: var(--r-0);
    padding-inline: var(--s-2);
    font-family: var(--t-meta-face);
    font-size: var(--t-meta-size);
    line-height: var(--t-meta-line);
    letter-spacing: var(--t-meta-track);
  }
</style>
