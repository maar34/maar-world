---
/**
 * Every migrated page, at the exact path the frozen route policy demands.
 *
 * Modelled on `[cardCode].astro`: `getStaticPaths` enumerates the collection, so
 * this route can only ever claim paths that a content record asked for. The
 * param is `outputPath` verbatim — never re-derived from a title, a slug or a
 * filename, because the whole point is that `/collect/cards/032_-maar-sky-
 * sounds.3-card X ` keeps its internal space *and* its trailing space.
 *
 * One file per page. The host serves `/x` and `/x.html` from the same `x.html`,
 * so both spellings resolve from a single emitted file and no twin is written.
 * Pages whose contract includes the literal `…/index.html` spelling carry an
 * `outputPath` ending `/index` for exactly that reason.
 *
 * Layout width is supplied by BaseLayout's shared content-frame contract. Every
 * page defaults to the same standard column; a future reviewed exception is a
 * schema value, not a route-local class.
 *
 * THE BODY WRAPPER IS `.prose`, AND IT IS NOT A MIGRATION ARTIFACT. Every page
 * this route renders goes through it — a migrated body and an authored one
 * alike — so it is the reading treatment of every page that will ever exist
 * here, including posts not yet written. It was called `.legacy` and that name
 * caused a bug: the rhythm of every page body was filed under a word meaning
 * "temporary", nobody audited it for completeness, and `h1` was left out of the
 * list of headings it styled. Two stylesheets now split by lifetime —
 * `styles/prose.css` is permanent and checked for completeness by
 * `verify:build`; `styles/legacy.css` holds only rules keyed to the dead
 * theme's class names and is deleted whole when the migration stops emitting
 * them.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlyphRun from '../components/patterns/GlyphRun.astro';
import TypeMark from '../components/patterns/TypeMark.astro';
import Stamp from '../components/patterns/Stamp.astro';
import Card from '../components/patterns/Card.astro';
import Home from '../components/families/Home.astro';
import TreeHub from '../components/families/TreeHub.astro';
import Collect from '../components/families/Collect.astro';
import LabIndex from '../components/families/LabIndex.astro';
import CollageField from '../components/patterns/CollageField.astro';
import CarouselScript from '../components/ui/CarouselScript.astro';
import PdfViewerScript from '../components/ui/PdfViewerScript.astro';
import EmbedConsentScript from '../components/ui/EmbedConsentScript.astro';
import HelixIsland from '../components/react/HelixIsland.astro';
import DocGlyph from '../components/ui/DocGlyph.astro';
import { globalLanguageChoices, alternatesFor, validateTranslations, navPathsFor, LANGS } from '../lib/translations.mjs';
import { stampText } from '../lib/mark.mjs';
import { docExcerpt } from '../lib/doc-excerpt.mjs';
import { collageFor, articleCoverFor, articleCoverFitFor, docGlyphFor, docReadMoreFor, LAB_INTRO, LAB_PINNED } from '../config/site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const byPath = new Map(pages.map((p) => [p.data.outputPath, p]));

  /**
   * A `translationOf` naming no page is reported HERE and asserted in
   * verify:translations — loudly in both places, fatal in neither.
   *
   * The failure being guarded against is silent: a dangling relation does not
   * error, it simply makes `alternatesFor` return nothing, so the page renders
   * exactly like one that has no translation. A Spanish page would be
   * published, reachable, and invisible from its English half — the shape of
   * failure `translationKey` was made a stored field to avoid.
   *
   * THIS THREW UNTIL IT WAS SEEN TO MISFIRE, and the reason it does not now is
   * worth keeping. `migrated/` is regenerated wholesale by migrate-pages.mjs,
   * so the set of pages a translation can point at is legitimately absent for
   * as long as that script is between runs. A throw here turns that ordinary
   * window into "nobody can build anything" — which is what happened when 34
   * collect card records were briefly regenerated away underneath 34 authored
   * Spanish translations of them. The defect is real and needs saying; it is
   * not worth taking the build down for, because `verify:translations` asserts
   * exactly the same thing, it is composed into `npm run verify`, and CI runs
   * it. Nothing ships past it.
   *
   * A build-time warning still gives the fast feedback a typo deserves, at
   * `npm run dev`, without coupling every build to the completeness of a
   * generated directory.
   */
  const danglingTranslations = validateTranslations(pages);
  if (danglingTranslations.length) {
    console.warn(
      `\n[translations] ${danglingTranslations.length} translationOf value(s) name a page ` +
        `that does not exist. verify:translations fails on this.\n  ` +
        `${danglingTranslations.join('\n  ')}\n` +
        '  Check the outputPath spelling — it is byte-for-byte.\n',
    );
  }

  /**
   * suit + title -> the NFC card record's Orbiter track id.
   *
   * The id lives on the NFC record and is NOT copied onto the collect record:
   * one card, one id, in one place. `suit_title` + `card_title` is the join
   * because both collections carry them and the pair is unique across the deck
   * — deriving it from a filename or a URL is what MW-7 spent a session undoing.
   */
  const cards = await getCollection('cards');
  const trackIdBySuitAndTitle = Object.fromEntries(
    cards
      .filter((c) => c.data.track_v2_id)
      .map((c) => [`${c.data.suit_title}|${c.data.card_title}`, c.data.track_v2_id]),
  );

  return pages.map((entry) => ({
    // Byte-for-byte. No trimming, no slugifying, no case folding.
    params: { page: entry.data.outputPath },
    props: { entry, all: [...byPath.values()], trackIdBySuitAndTitle },
  }));
}

const { entry, all, trackIdBySuitAndTitle } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

/**
 * `{% include article-list.html %}` used to render these.
 *
 * Membership comes from `indexGroup` — the legacy Jekyll collection the record
 * was migrated out of — not from `kind`, which is derived from the URL. The two
 * are not the same set: `/collect/privacy` belongs to `site.documentation` but
 * is published at the site root, so a URL-derived filter left it out and the
 * Documentation index rendered nine entries where production renders ten.
 */
/**
 * …in the index's OWN LANGUAGE, and only its own.
 *
 * That rule was already settled for the Lab a few lines down, in the owner's
 * words — "if we have English selected we show the English articles" — and it
 * is the same rule for every other index: a Spanish documentation index listing
 * ten English documents beside ten Spanish ones is the twenty-entry Lab page
 * that note describes, with the duplicates adjacent because they share a title.
 *
 * Applied here rather than per index so it holds for indexes that do not exist
 * yet. It makes the Lab's own language filter below redundant; that one is left
 * where it is because it states the reasoning at the place a reader of the Lab
 * page will look for it.
 *
 * Nothing becomes unreachable: every entry is listed on the index in its own
 * language, and both indexes are translations of each other, so the header's
 * language chip reaches either.
 */
const listed = d.indexOf
  ? all.filter((p) => p.data.indexGroup === d.indexOf && p.data.lang === d.lang)
  : [];

/**
 * Dated collections (the Lab) read newest first. Undated ones fall through to
 * `indexOrder`, the collection-relative source path, which is the order Jekyll
 * itself rendered — `03-ent-cards.md` before `03-ent-cards/01-sustainability.md`
 * because `.` sorts before `/`.
 */
const sorted = [...listed].sort((a, b) => {
  const da = String(a.data.date ?? '');
  const db = String(b.data.date ?? '');
  if (da !== db) return db.localeCompare(da);
  const oa = String(a.data.indexOrder ?? '');
  const ob = String(b.data.indexOrder ?? '');
  if (oa !== ob) return oa.localeCompare(ob);
  return a.data.outputPath.localeCompare(b.data.outputPath);
});

/**
 * dist-relative outputPath → the URL a browser asks for.
 *
 * Percent-encoded, because one Collect card path ends in a space and an href
 * with a trailing literal space is not reliably preserved by anything that
 * touches it — including HTML parsers. `%20` is the spelling the frozen
 * manifest itself records, so this is the contract's own form, not a tidy-up.
 */
const hrefOf = (outputPath: string) =>
  encodeURI(`/${outputPath.replace(/(^|\/)index$/, '')}`.replace(/\/(?=$)/, '')) || '/';

const isCard = d.kind === 'collect-card';

/**
 * The Orbiter address for this card, or null. Identical in shape to the one
 * `[cardCode].astro` builds for the physical card's forward, so the page a
 * visitor reaches by tapping the card and the player embedded here are the
 * same address by construction rather than by coincidence.
 */
const cardTrackId = isCard ? trackIdBySuitAndTitle?.[`${d.suit_title}|${d.card_title}`] : null;
const orbiterUrl = cardTrackId ? `https://orbiter.plantasia.space/?trackId=${cardTrackId}` : null;

/**
 * Which pages load the carousel script — only pages with a body carousel.
 *
 * MW-7's rule was "application JavaScript on exactly one page". The owner has
 * amended it for ui/carousel, and the amendment is narrowed here rather than
 * taken as licence: the test is whether this record's own body actually carries
 * a carousel, so a page gains the bundle by having a gallery on it and by
 * nothing else. Put in BaseLayout it would have shipped to all 134.
 */
const hasCarousel = /class="carousel"/.test(entry.body ?? '');
const hasPdfEmbed = /class="[^"]*pdf-embed/.test(entry.body ?? '');

/**
 * Which pages load the embed consent gate — only pages with a facade the gate
 * can actually open. The owner's third JavaScript exception (2026-07-30, see
 * ui/EmbedConsentScript) is narrowed here on the same principle as the carousel:
 * the test is this record's own body, and the provider list is the one the gate
 * understands, so a page with only a Google Form or the radio stream on it stays
 * click-out and ships nothing.
 */
const hasMediaEmbed = /data-embed-provider="(?:youtube|vimeo|soundcloud|google-calendar)"/.test(entry.body ?? '');
/* Which sections carry a header, and which picture each one gets, both live in
   SECTION_COLLAGE. A section is given a header by being in that map — there is
   no second list here to fall out of step with it. */
const sectionCollage = d.outputPath ? collageFor(d.outputPath) : null;

/**
 * The language switcher, and the <link rel="alternate"> set.
 *
 * This replaces the two buttons the legacy body carried at /lab
 * (`?tag=EN` / `?tag=ES`). Those pointed at query-string filters on a static
 * build with no JavaScript, so both served the identical unfiltered page: a
 * visible, clickable, inert control. They are stripped by the migration now.
 */
const langChoices = globalLanguageChoices(entry, all);
const alternates = alternatesFor(entry, all);

/**
 * The header's destinations, in this page's language.
 *
 * SECTIONS is English-only, so without this every nav click on a Spanish page
 * returned the reader to English and /es/collect was reachable by no link on
 * the site. See navPathsFor.
 */
const navPaths = navPathsFor(d.lang, all);

/**
 * The Lab reads as a dated bibliography, not a list of links, so it groups by
 * year with a rule per group — the spec's page family 02, and what production
 * served. Every other index is a flat list of titles.
 *
 * Grouping is derived from the records rather than declared, so nothing has to
 * be updated when a year rolls over.
 */
const isYearIndex = d.indexOf === 'lab';

/**
 * THE DOCUMENTATION INDEX, WHICH IS A COVERED INDEX THAT SHOWS NO COVERS.
 *
 * It is still `card-grid` and still `card.entry` — MW-16 asks for cards that
 * are "visually consistent with the rest of the website", so this is the same
 * component at the same size, not a Docs-only card. Three slots change and
 * nothing else does:
 *
 *   cover   → dropped for a glyph. The ten records DO carry a `cover`, so this
 *             is a deliberate override rather than an empty field falling
 *             through: they are dark photographs of unrelated subjects that
 *             rendered as ten near-identical black rectangles. See DOC_GLYPHS.
 *   excerpt → the article's own opening sentence, read out of its body, since
 *             none of these records has a `description`. See lib/doc-excerpt.
 *   meta    → "read more" instead of the language code. Every entry on this
 *             page is already in the page's own language (the `listed` filter
 *             above), so "en" on all ten said nothing; the meta line is where
 *             this site puts a card's call to action, exactly as the Collect
 *             landing puts "watch tutorials" and "collect" there.
 */
const isDocsIndex = d.indexOf === 'collect-docs';

/**
 * READING TIME, COUNTED RATHER THAN CLAIMED.
 *
 * The Lab design puts "9 min read" on its lead entry. It is one of the few
 * figures in that design the site can actually produce, so it is produced: the
 * record's own body, tags stripped, at 200 words a minute — the conventional
 * rate, and the one worth stating here because a number with no stated basis is
 * a number nobody can check. Floored at one, because "0 min read" is noise.
 *
 * Counted at build time from the same string `verify:content` measures, so it
 * cannot drift from what the page actually says.
 */
const READING_WORDS_PER_MINUTE = 200;
const readingMinutes = (body: string) => {
  const words = body
    .replace(/<[^>]*>/g, ' ')
    .split(/\s+/)
    .filter(Boolean).length;
  return Math.max(1, Math.round(words / READING_WORDS_PER_MINUTE));
};

/**
 * The Lab's entries, as the plain data page family 02 renders.
 *
 * The mapping happens here rather than in the family because this is where a
 * content record's shape is known — `hrefOf` and the collection's fields are
 * route concerns, and `LabIndex` should be handed a list it can lay out without
 * knowing what a content collection is.
 */
const labEntries = isYearIndex
  ? sorted
      /**
       * THE INDEX SHOWS ITS OWN LANGUAGE, AND ONLY ITS OWN.
       *
       * Ten pieces, each written twice, were rendering as twenty entries on one
       * page: every piece listed once in English and once in Spanish, with the
       * pair adjacent because they share a date. The owner's words — "if we
       * have English selected we show the English articles" — and the header's
       * language chip already switches between `/lab` (en) and `/es/lab` (es),
       * which are translations of each other, so the language filter the design
       * draws as a chip is a control this site already has.
       *
       * Nothing becomes unreachable: each Spanish entry is on `/es/lab`, and
       * each article's own page carries the switch to its twin.
       */
      .filter((p) => p.data.lang === d.lang)
      .filter((p) => p.data.date)
      .map((p) => {
        const href = hrefOf(p.data.outputPath);
        return {
          href,
          title: p.data.indexLabel ?? p.data.title,
          date: String(p.data.date).slice(0, 10),
          lang: p.data.lang,
          /**
           * THE LANGUAGE TAGS COME OFF.
           *
           * Every Lab record carries "EN" or "ES" in its tag list — hooks for
           * production's `/lab.html?tag=EN` filter, which was a script MW-7
           * forbids and which this index replaces with a real per-language
           * page. On an index that is already one language, a chip saying "en"
           * on all ten cards is the page telling the reader something they
           * chose in the header.
           *
           * Only the language codes go. Every topical tag stays.
           */
          tags: (p.data.tags ?? []).filter(
            (t: string) => !LANGS.includes(t.toLowerCase()),
          ),
          excerpt: p.data.description,
          /* The record's own cover if it ever gains one; otherwise the collage
             chosen for that destination in config/site.ts. */
          cover: p.data.cover ?? articleCoverFor(href),
          coverFit: articleCoverFitFor(href),
          minutes: readingMinutes(p.body ?? ''),
          /* What LAB_PINNED names — the piece, not one language of it. */
          translationKey: p.data.translationKey,
        };
      })
  : [];

---

<BaseLayout
  title={d.title}
  description={d.description ?? d.card_description}
  noindex={d.noindex}
  area={d.area}
  lang={d.lang}
  alternates={alternates.map((p) => ({ lang: p.data.lang, outputPath: p.data.outputPath }))}
  redirectTo={d.redirectTo}
  contentWidth={d.contentWidth}
  languageChoices={langChoices}
  navPaths={navPaths}
>
  {
    /**
     * PAGE FAMILY 01 — home. §08 gives it one sentence: "one feature card, then
     * three entry cards. no sidebar."
     *
     * Every route enters through the same standard shell frame. A family changes
     * structure, never the page's outer width; contentWidth is the one explicit
     * schema-controlled exception point when a future design genuinely needs it.
     *
     * The dispatch is `family`, a schema enum, not `outputPath === 'index'`.
     * Nine more skeletons are specified and four of them are card grids; a
     * chain of URL comparisons is the thing to have avoided starting.
     */
    d.family === 'tree' && <TreeHub headingHtml={d.headingHtml} title={d.indexLabel ?? d.title} lang={d.lang} />
  }
  {
    d.family === 'home' && (
      <Home
        headingHtml={d.headingHtml}
        title={d.indexLabel ?? d.title}
        lede={d.lede}
        feature={d.feature}
        entries={d.entries}
        tonguesLabel={d.tonguesLabel}
        tongues={d.tongues}
        seed={d.outputPath}
      >
        <Content />
      </Home>
    )
  }

  {
    /**
     * The Collect landing. Its opening is still the migrated body and goes in
     * through the slot; the family owns the closing section, which was three
     * grey hero plates and a card the theme drew as nothing.
     */
    d.family === 'collect' && (
      <Collect seed={d.outputPath} label={d.indexLabel ?? d.title} statement={d.description}>
        <Content />
      </Collect>
    )
  }

  {
    /**
     * PAGE FAMILY 02 — editorial index. §05: "year groups with a single
     * grouping hairline. filters as chips. no row separators."
     *
     * The Lab, and the only page that is one. The dispatch is `indexOf`, the
     * schema field that already declares this page renders the Lab's list —
     * not a comparison against its URL, and not a second `family` field saying
     * the same thing a different way.
     *
     * The authored body — heading, statement, rule — goes into the family as a
     * slot rather than being lifted into fields the way family 01's is. Family
     * 01 had to: its heading and its three cards are `patterns/card` props, and
     * a card takes props. This page's intro is prose, is already marked, and is
     * one measure of text; making it two fields would put the Lab's opening
     * sentence somewhere other than the Lab's page.
     */
    isYearIndex && (
      <LabIndex
        entries={labEntries}
        collage={sectionCollage}
        label={d.indexLabel ?? d.title}
        headingHtml={(LAB_INTRO[d.lang] ?? LAB_INTRO.en).headingHtml}
        lede={(LAB_INTRO[d.lang] ?? LAB_INTRO.en).lede}
        strings={(LAB_INTRO[d.lang] ?? LAB_INTRO.en).strings}
        pinnedKey={LAB_PINNED}
      />
    )
  }

  {!d.family && !isYearIndex && (
  <Fragment>
  {/* The shell owns <main> and the standard content frame. This route supplies
      structure only; no route or content type sets its own outer width. */}
  <div class:list={['page', (sectionCollage || d.family === 'home') && 'page--hero']}>
    {
      /* The label line, with no mark on it.
         The rules-of-use table permits marks at h1 and card-cover level and
         forbids them at body, ui, label and caption level — and this is a label
         line. The glyph run that used to sit here now sits in the h1 below,
         where up to two are allowed and where zero were being used. */
      isCard && (
        <p class="t-meta suit">
          <span>{d.suit_title}</span>
          <span>{d.card_title}</span>
        </p>
      )
    }

    {
      /* Two marks, which is the h1 maximum: the glyph run, and one word of the
         title cut out of a different sheet. Below 600px the responsive table
         allows one, so `h1--marked-glyphs` stands the cut word down there and
         leaves the run — it is already aria-hidden and carries no word.
         Both are decoration: the accessible name is the card title alone. */
      isCard && (
        <h1 class="h1--marked-glyphs">
          <TypeMark text={d.card_title} seed={d.outputPath} />
          {' '}
          <GlyphRun seed={d.outputPath} />
        </h1>
      )
    }

    {
      /* One mark at card-cover level, where the table allows two and nothing was
         spending them: the edition numeral, stamped on the mount rather than on
         the artwork. See src/components/patterns/Stamp.astro for why not over
         the image. `cover--stamped` opens the mount only on the covers that have
         one, so a card with no numeral is laid out exactly as it was. */
      isCard && d.card_image && (
        <figure class:list={['cover', 'plate', stampText(d.card_title) && 'cover--stamped']}>
          <Stamp cardTitle={d.card_title} />
          <img src={d.card_image} alt={`${d.suit_title} ${d.card_title}`} loading="lazy" decoding="async" />
        </figure>
      )
    }

    {isCard && d.card_description && <p class="description">{d.card_description}</p>}

    {
      /* These five areas use the same compact visual introduction. The page H1
         remains in its authored body below, so the hero is atmospheric rather
         than a second, duplicate heading. */
      sectionCollage && (
        <CollageField
          src={sectionCollage}
          variant="section"
          label={`${d.indexLabel ?? d.title} visual header`}
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      /* The single approved island. Astro emits JavaScript only for pages that
         mount one, so this branch is also the reason every other page in the
         build ships none. */
      d.island === 'helix' && <HelixIsland />
    }

    {
      /**
       * THE CARD'S PLAYER.
       *
       * The Plantasia Orbiter where the card has a track id — 33 of the 34; the
       * wild card has none and keeps the play.maar.world snippet, which is also
       * the fallback if an id is ever removed.
       *
       * Embedded on load rather than behind the consent gate, by the owner's
       * decision of 2026-07-31: plantasia.space is the owner's own property, not
       * a third party, and `verify:links` FIRST_PARTY was widened to say so.
       * WHAT THAT DECISION BUYS AND COSTS IS RECORDED IN THE LEDGER —
       * `ledger -- find orbiter-inline` — because the Orbiter does write device
       * storage and does pull Google Fonts, and this file is where someone will
       * come looking when they ask why.
       *
       * `loading="lazy"` is load-bearing here in a way it was not for the old
       * player: the Orbiter is WebGL plus an audio engine and takes ~10s to
       * boot, so it must not start until it is near the viewport.
       */
      isCard && (orbiterUrl || d.snip_player) && (
        <iframe
          src={orbiterUrl ?? d.snip_player}
          title={`${d.suit_title} ${d.card_title} player`}
          loading="lazy"
          scrolling="no"
          allow="accelerometer; autoplay; gyroscope; magnetometer; fullscreen; xr-spatial-tracking"
          referrerpolicy="strict-origin-when-cross-origin"
          class="player orbiter-embed"
        />
      )
    }

    {
      /**
       * A covered index is a CARD GRID — patterns/card, §04 — and this is the
       * component's first consumer.
       *
       * What it replaces put a link on the thumbnail AND a link on the title of
       * every row, both going to the same page: every entry twice in the tab
       * order and twice to a screen reader, with the first one `aria-hidden`
       * and `tabindex="-1"` to paper over it. The spec settles that outright —
       * "the whole card is one link target" — so the card is one `<a>` and the
       * problem stops existing rather than being suppressed.
       *
       * THE COVER IS `cover`, NEVER `card_image`. These records carry both, and
       * `card_image` is a dropbox.com URL: rendering 34 of them here would take
       * the on-load third-party count from 73 to 107, and that number must
       * never go up. `cover` is the (currently missing) thumbnail, so most of
       * these render the hatch plate — which is exactly what the spec draws an
       * empty cover as, and what the lost-thumbnails BLOCKED item looks like
       * until a human resolves it.
       *
       * An uncovered index stays a list of links. It is a list of links.
       */
      sorted.length > 0 && !isYearIndex && d.indexCovers && (
        <div class="card-grid">
          {sorted.map((p) => (
            <Card
              variant="entry"
              href={hrefOf(p.data.outputPath)}
              title={p.data.indexLabel ?? p.data.title}
              level={2}
              cover={isDocsIndex ? undefined : p.data.cover}
              coverShape={d.indexCoverShape}
              scatter={d.indexScatter}
              badge={p.data.suit_title}
              badgeOutline={p.data.date ? String(p.data.date).slice(0, 4) : undefined}
              excerpt={
                p.data.card_description ??
                p.data.description ??
                (isDocsIndex ? docExcerpt(p.body) ?? undefined : undefined)
              }
              meta={isDocsIndex ? docReadMoreFor(d.lang) : p.data.lang}
              seed={p.data.outputPath}
            >
              {isDocsIndex && <DocGlyph slot="cover" name={docGlyphFor(p.data.outputPath)} />}
            </Card>
          ))}
        </div>
      )
    }

    {
      sorted.length > 0 && !isYearIndex && !d.indexCovers && (
        <ul role="list" class="index-list">
          {sorted.map((p) => (
            <li>
              <a href={hrefOf(p.data.outputPath)}>{p.data.title}</a>
              {p.data.date && <span class="t-meta"> {String(p.data.date).slice(0, 10)}</span>}
              {p.data.lang && <span class="t-meta"> {p.data.lang}</span>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
  </Fragment>
  )}

  {hasCarousel && <CarouselScript />}
  {hasPdfEmbed && <PdfViewerScript />}
  {hasMediaEmbed && <EmbedConsentScript />}
</BaseLayout>

<style>
