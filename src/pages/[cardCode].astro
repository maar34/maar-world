---
/**
 * The NFC card pages — the hardest contract in the programme.
 *
 * 35 codes are printed on physical cards already in people's hands. This route
 * emits `CODE.html` at the output root for each; the extensionless `/CODE` is
 * then served by the host's `.html` fallback. Both forms must return 200, never
 * redirect, and stay byte-for-byte stable in spelling and casing.
 *
 * `getStaticPaths` returns exactly the 35 codes from the typed collection, so
 * this dynamic route cannot accidentally claim any other URL. Static routes take
 * priority in Astro, so later pages (/about, /lab…) are unaffected.
 *
 * Layout is page family 03 (entry): single measure, 66ch max, h1 may carry
 * marks and nothing below it does.
 *
 * There is deliberately no commerce link. MW-6 and MW-1 both say no Bandcamp,
 * storefront or checkout integration is introduced; the destination is the
 * Artizen project page once its URL exists, read from one config value. That URL
 * does not exist yet, so no destination renders at all — see BLOCKED in the
 * migration ledger.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlyphRun from '../components/patterns/GlyphRun.astro';
import TypeMark from '../components/patterns/TypeMark.astro';
import { COMMERCE } from '../config/site';

export async function getStaticPaths() {
  const cards = await getCollection('cards');
  return cards.map((card) => ({
    // The param IS the printed code. Never transform, normalise or re-case it.
    params: { cardCode: card.data.permalink.replace(/^\//, '') },
    props: { card },
  }));
}

const { card } = Astro.props;
const d = card.data;
const { Content } = await render(card);

/**
 * The Orbiter forward, and its no-JavaScript fallback.
 *
 * Production card pages return 200 and then forward to the Orbiter listening
 * experience 300ms later, via `window.location.href`. This is what actually
 * happens when someone taps a physical card, and it is part of the production
 * contract — a crawler never sees it because it does not run JavaScript.
 *
 * Exactly the 33 cards carrying `track_v2_id` forward; the wild card (DWE1406)
 * and STW3344 have no track and do not, which is verified against production.
 * So the presence of `track_v2_id` is the condition, not a flag of its own.
 *
 * This is NOT an HTTP redirect. The URL still returns 200 and never 3xx, which
 * is what the physical-card contract requires.
 *
 * The timeout is only half of it. Legacy `_layouts/card.html` (and therefore
 * live production, verified with `curl https://maar.world/EBT5599`) also emits a
 * VISIBLE `<a href="https://orbiter.plantasia.space/?trackId=…">Open Maar
 * Orbiter</a>`, the line "If nothing happens automatically, use the button
 * above", and a `<noscript>` note. That anchor is the whole degradation story:
 * with JavaScript restricted — Lockdown Mode, a locked-down in-app webview, a
 * content blocker — the script never runs, and without the anchor a tapped
 * physical card would offer no route to the Orbiter at all. It is restored here
 * for the same cards that forward.
 *
 * The visible label is production's: `track_v2_slug`, falling back to the card
 * title, exactly as the Liquid `track_redirect_label` default chain did.
 */
const orbiterUrl = d.track_v2_id
  ? `https://orbiter.plantasia.space/?trackId=${d.track_v2_id}`
  : null;
const orbiterLabel = d.track_v2_slug ?? d.card_title;

/**
 * The document title.
 *
 * NOT `titles.en`. That field is a legacy display string and it is not unique:
 * `_stoney_way` carries a copy-pasted `titles.en` of "Maar Sky Sounds Card I",
 * so promoting it would title a Stoney Way card — Spanish/Catalan text about a
 * stone from Uruguay — as a Sky Sounds card, identical to EBT5599. The
 * frontmatter is correct as a record of the source, so the fix belongs here.
 *
 * Jekyll derived the title from the filename, which is why production serves
 * "001_ Maar Sky Sounds.1 Card_i" and "001_ Sebas Stoney_way" — ugly, but
 * distinct per card. `suit_title` + `card_title` carries the same distinction
 * in readable form and is unique across all 35.
 */
const cardName = `${d.suit_title} ${d.card_title}`;

/**
 * Player and download semantics.
 *
 * Legacy `card.html` names the two media pairs by what they CONTAIN, not by
 * file format: `player`/`download` is the soundscapes & music mix, and
 * `player2`/`download2` is the spoken word reading. Labelling both by file
 * extension produces two links reading "wav", which tells neither a sighted
 * reader nor a screen reader which is which.
 *
 * STW3344 is the exception, and deliberately so: it never used `card.html`. Its
 * Jekyll body rendered a single "music" player and offered one mix in two
 * formats, so for that record the format IS the distinction. (Its legacy body
 * labels the .mp3 "download wav" and the .wav "download mp3" — a source typo;
 * the file decides, not the stale label.)
 */
const isStoney = d.source === 'stoney_way';

const audioFormat = (href: string) =>
  /\.wav(\?|#|$)/i.test(href) ? 'wav' : /\.mp3(\?|#|$)/i.test(href) ? 'mp3' : 'audio';

const playerLabels = isStoney
  ? ['music', 'music', 'excerpt']
  : ['soundscapes & music', 'spoken word', 'excerpt'];

const players = [d.player, d.player2, d.snip_player]
  .map((src, i) => (src ? { src: src as string, label: playerLabels[i] } : null))
  .filter((p): p is { src: string; label: string } => p !== null)
  // STW3344 lists the same player URL as both `player` and `player2`.
  // Production renders it once; two identical iframes under two different
  // labels would be a new falsehood, not a restored one.
  .filter((p, i, all) => all.findIndex((q) => q.src === p.src) === i);

const downloads = [d.download, d.download2]
  .map((href, i) =>
    href
      ? {
          href: href as string,
          label: isStoney ? `mix (${audioFormat(href as string)})` : playerLabels[i],
        }
      : null,
  )
  .filter((x): x is { href: string; label: string } => x !== null);
---

{/* The 35 NFC cards are served from the maar.world root, so they are maar-area
    pages. They carry no `lang`, and every one of them is English. */}
<BaseLayout title={cardName} description={d.card_description} noindex={true} area="maar">
  {/* The shell owns <main>. This is the page family inside it. */}
  <div class="card-page shell__inner measure">
    {
      orbiterUrl && (
        <section class="orbiter" aria-label="now playing on Maar Orbiter">
          {/* Deliberately not an <h2>: this block precedes the page's <h1>, and
              a heading above the h1 inverts the document outline. The section
              is a labelled landmark instead, so it is still announced. */}
          <p class="orbiter__head">{orbiterLabel} is now playing on Maar Orbiter</p>
          <p class="orbiter__lede">We are redirecting you to the updated listening experience.</p>
          <a class="btn btn--primary orbiter__link" href={orbiterUrl} rel="noopener">
            Open Maar Orbiter
          </a>
          <p class="orbiter__hint">
            If nothing happens automatically, use the button above. The card remains below.
          </p>
          <noscript>
            <p class="orbiter__noscript">
              <strong>JavaScript is disabled.</strong> Use the button above to open the Maar
              Orbiter track page.
            </p>
          </noscript>
        </section>
      )
    }

    {/* The label line, with no mark on it.
        The rules-of-use table permits marks at h1 and card-cover level and
        forbids them at body, ui, label and caption level — and this is a label
        line. The glyph run that used to sit here now sits in the h1 below,
        where up to two are allowed and where zero were being used. */}
    <p class="t-meta suit">
      <span>{d.suit_title}</span>
      <span>{d.card_title}</span>
    </p>

    {/* Two marks, which is the h1 maximum: the glyph run, and one word of the
        title cut out of a different sheet. The responsive table caps an h1 at
        one mark below 600px, so `h1--marked-glyphs` tells mark.css to stand the
        cut word down there and leave the glyph run — the run is already
        aria-hidden and carries no word, so standing the other one down costs a
        reader nothing.

        Both are decoration to a screen reader: the run is aria-hidden, and the
        mark is a span around a word it does not change. The accessible name is
        the card title, exactly as before. */}
    <h1 class="h1--marked-glyphs"><TypeMark text={d.card_title} seed={d.permalink} />{' '}<GlyphRun seed={d.permalink} /></h1>

    <figure class="cover">
      <img src={d.card_image} alt={`${d.suit_title} ${d.card_title}`} loading="lazy" decoding="async" />
    </figure>

    <p class="description">{d.card_description}</p>

    <Content />

    {
      players.length > 0 && (
        <section class="players" aria-label="players">
          {players.map((p) => (
            <div class="player-block">
              <p class="t-meta player-label">{p.label}</p>
              <iframe
                src={p.src}
                title={`${cardName} — ${p.label}`}
                loading="lazy"
                class="player"
              />
            </div>
          ))}
        </section>
      )
    }

    {
      downloads.length > 0 && (
        <section class="downloads" aria-label="downloads">
          <p class="t-meta">download</p>
          <ul role="list" class="download-list">
            {downloads.map((dl) => (
              <li>
                <a href={dl.href}>{dl.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      COMMERCE.destinationUrl && (
        <p class="destination">
          <a href={COMMERCE.destinationUrl}>{COMMERCE.destinationName}</a>
        </p>
      )
    }
  </div>

  {
    orbiterUrl && (
      <script is:inline set:html={`(function () {
  var redirectUrl = ${JSON.stringify(orbiterUrl)};
  window.setTimeout(function () {
    window.location.href = redirectUrl;
  }, 300);
})();`} />
    )
  }
</BaseLayout>

<style>
  /* Page family 03 — entry. Single measure, 66ch max — supplied by
     .shell__inner.measure, along with the shell's responsive gutter. */
  .card-page {
    padding-block: var(--s-16) var(--s-24);
    display: flex;
    flex-direction: column;
    /* Sibling groups use gap, never margins. Space is the primary separator. */
    gap: var(--s-6);
  }

  /* The no-JavaScript route to the Orbiter. Tokens only — no raw hex, no raw
     pixel size, no raw duration. One pigment for the instance (--c-maar, the
     wayfinding pigment), used as a background with dark type, per the spec. */
  .orbiter {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6);
    background: var(--sf-raised);
    border-radius: var(--r-0);
  }

  .orbiter p {
    margin: 0;
  }

  .orbiter__head {
    font-family: var(--t-h3-face);
    font-weight: var(--t-h3-weight);
    font-size: var(--t-h3-size);
    line-height: var(--t-h3-line);
  }

  .orbiter__lede {
    color: var(--ink-muted);
  }

  /* The primary button now comes from styles/button.css, which is the spec's
     own state table rather than a local approximation of it. What stays here is
     the one thing that is about this layout and not about the button: where it
     sits in the column. It used to restate the field, the face and the padding,
     and it had no hover, no press nudge and no disabled state. */
  .orbiter__link {
    align-self: start;
  }

  .orbiter__hint,
  .orbiter__noscript {
    color: var(--ink-meta);
    font-size: var(--t-small-size);
    line-height: var(--t-small-line);
  }

  .orbiter__noscript {
    padding: var(--s-3);
    background: var(--sf-raised-2);
    border-radius: var(--r-0);
  }

  .suit {
    color: var(--ink-meta);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
  }

  /* Cover ratio is 3:2 everywhere except card.compact and card.place. */
  .cover {
    margin: 0;
    background: var(--sf-raised);
    border-radius: var(--r-0);
  }

  .cover img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .description {
    color: var(--ink-muted);
  }

  .players {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .player-block {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .player-label {
    color: var(--ink-meta);
    margin: 0;
  }

  /* play.maar.world shares the registrable domain, so it is same-site even
     inside an iframe and needs no click-to-load facade. Third-party embeds do. */
  .player {
    width: 100%;
    min-height: 220px;
    border: 0;
    background: var(--sf-sunken);
    border-radius: var(--r-0);
  }

  .downloads .t-meta {
    color: var(--ink-meta);
    margin: 0 0 var(--s-2);
  }

  .download-list {
    display: flex;
    gap: var(--s-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
